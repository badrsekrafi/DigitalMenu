<link rel="stylesheet" href="/css/Sidebar.css">

<div class="sidebar-backdrop" id="sidebarBackdrop"></div>
<aside class="sidebar" id="sidebar">
    <div class="sidebar-header">
        <a href="/Home" class="logo">
            <div class="logo-icon">
                <img src="/images/logo.png" alt="Le Patio Logo" onerror="this.src='/images/Admin_image.png'">
            </div>
            <div class="logo-text">
                <span class="brand-title">Dine<span class="brand-accent">/</span>Delight</span>
                <span class="brand-subtitle">Restaurant Management</span>
            </div>
        </a>
    </div>

    <nav class="sidebar-nav">
        <a href="/Home" class="nav-link" id="dashboard">
            <i class="fa-solid fa-border-all"></i>
            <span>Dashboard</span>
        </a>
        <a href="/Categories" class="nav-link" id="categories">
            <i class="fa-solid fa-layer-group"></i>
            <span>Categories</span>
        </a>
        <a href="/Menu_Dishes" class="nav-link" id="menudishes">
            <i class="fa-solid fa-utensils"></i>
            <span>Menu Dishes</span>
        </a>
        <a href="/Orders" class="nav-link" id="orders">
            <i class="fa-solid fa-bag-shopping"></i>
            <span>Orders</span>
        </a>
        <a href="/QR_Code" class="nav-link" id="qrcode">
            <i class="fa-solid fa-qrcode"></i>
            <span>QR Code</span>
        </a>
        <a href="/ImgUploader_add" class="nav-link" id="imguploader">
            <i class="fa-solid fa-chair"></i>
            <span>Tables</span>
        </a>
        <a href="/Reports" class="nav-link" id="reports">
            <i class="fa-solid fa-chart-line"></i>
            <span>Reports</span>
        </a>
        <a href="/Settings" class="nav-link" id="settings">
            <i class="fa-solid fa-gear"></i>
            <span>Settings</span>
        </a>
        <a href="/Users" class="nav-link" id="users">
            <i class="fa-solid fa-users"></i>
            <span>Users</span>
        </a>
    </nav>

    <div class="sidebar-footer">
        <div class="sidebar-user">
            <img src="/images/Admin_image.png" alt="Admin avatar" class="user-avatar">
            <div class="user-info">
                <span class="user-name">{{adminName}}</span>
                <span class="user-role">Administrator</span>
            </div>
            <button id="signout-button" type="button" class="user-logout-btn" title="Sign Out">
                <i class="fa-solid fa-right-from-bracket"></i>
            </button>
        </div>
    </div>
</aside>
