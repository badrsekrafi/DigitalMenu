<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rapports & Analytiques | Dine/Delight</title>
    <link rel="stylesheet" href="/css/admin-theme.css">
    <link rel="stylesheet" href="/css/homepage.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>

<body>
    <div class="main">
        <div class="bigBox">
            {{>Sidebar}}

            <main class="boxes fade-in">
                <section class="upperbox">
                    <div class="upperbox-text">
                        <p class="eyebrow">Analytiques</p>
                        <h1>Rapports & Performances</h1>
                    </div>
                    <button class="upperbox-btn" onclick="openExportModal()">
                        <i class="fa-solid fa-file-invoice-dollar"></i>
                        <span>Exporter le rapport</span>
                    </button>
                </section>

                <section class="stats-grid" aria-label="Chiffres clés des rapports">
                    <article class="stat-card stat-card-orange fade-in-1">
                        <div class="stat-icon-wrapper">
                            <i class="fa-solid fa-dollar-sign"></i>
                        </div>
                        <div class="stat-info">
                            <span class="stat-label">REVENUS (AUJ.)</span>
                            <h3 class="stat-value">{{analytics.revenueToday}} DNT</h3>
                            <div class="stat-trend is-{{analytics.revenueTrend.direction}}">
                                <i class="fa-solid fa-arrow-{{analytics.revenueTrend.direction}}"></i>
                                <span>{{analytics.revenueTrend.pct}}%</span>
                                <span class="stat-trend-period">vs hier</span>
                            </div>
                        </div>
                    </article>

                    <article class="stat-card stat-card-purple fade-in-2">
                        <div class="stat-icon-wrapper">
                            <i class="fa-solid fa-basket-shopping"></i>
                        </div>
                        <div class="stat-info">
                            <span class="stat-label">COMMANDES (AUJ.)</span>
                            <h3 class="stat-value">{{analytics.ordersToday}}</h3>
                            <div class="stat-trend is-{{analytics.ordersTrend.direction}}">
                                <i class="fa-solid fa-arrow-{{analytics.ordersTrend.direction}}"></i>
                                <span>{{analytics.ordersTrend.pct}}%</span>
                                <span class="stat-trend-period">vs hier</span>
                            </div>
                        </div>
                    </article>

                    <article class="stat-card stat-card-pink fade-in-3">
                        <div class="stat-icon-wrapper">
                            <i class="fa-solid fa-fire"></i>
                        </div>
                        <div class="stat-info">
                            <span class="stat-label">TOP VENTES</span>
                            <h3 class="stat-value" style="font-size:16px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                                {{#each analytics.topItems}}{{#if @first}}{{this.name}}{{/if}}{{else}}N/A{{/each}}
                            </h3>
                            <span class="stat-trend-period">Plus populaire cette semaine</span>
                        </div>
                    </article>

                    <article class="stat-card stat-card-green fade-in-4">
                        <div class="stat-icon-wrapper">
                            <i class="fa-solid fa-layer-group"></i>
                        </div>
                        <div class="stat-info">
                            <span class="stat-label">CATÉGORIES ACTIVES</span>
                            <h3 class="stat-value">{{analytics.categoryDistribution.length}}</h3>
                            <span class="stat-trend-period">Groupes au catalogue</span>
                        </div>
                    </article>

                    <article class="stat-card fade-in-4" style="background:#FFFBF2;border:1px solid #FDE68A;">
                        <div class="stat-icon-wrapper" style="background:#FEF3C7;color:#D97706;">
                            <i class="fa-solid fa-star"></i>
                        </div>
                        <div class="stat-info">
                            <span class="stat-label">NOTE CLIENTS</span>
                            <h3 class="stat-value" style="color:#D97706;">{{fullReport.averageRatingFormatted}} / 5.0 ⭐</h3>
                            <span class="stat-trend-period">Basé sur {{fullReport.customerFeedbacksCount}} avis</span>
                        </div>
                    </article>
                </section>

                <section class="analytics-section">
                    <div class="section-header">
                        <h2>Graphiques d'activité (7 derniers jours)</h2>
                    </div>

                    <div class="analytics-grid">
                        <article class="analytics-card">
                            <div class="analytics-card-header">
                                <div>
                                    <span class="analytics-card-title">Évolution des revenus</span>
                                </div>
                            </div>
                            <div class="chart-container">
                                <canvas id="reportRevenueChart"></canvas>
                            </div>
                        </article>

                        <article class="analytics-card">
                            <div class="analytics-card-header">
                                <div>
                                    <span class="analytics-card-title">Volume des commandes</span>
                                </div>
                            </div>
                            <div class="chart-container">
                                <canvas id="reportOrdersChart"></canvas>
                            </div>
                        </article>

                        <article class="analytics-card">
                            <div class="analytics-card-header">
                                <div>
                                    <span class="analytics-card-title">Top 5 des plats les plus vendus</span>
                                </div>
                            </div>
                            <div class="top-items-list">
                                {{#each analytics.topItems}}
                                <div class="top-item-row">
                                    <div class="top-item-info">
                                        <span class="top-item-rank">{{inc @index}}.</span>
                                        <span class="top-item-name">{{this.name}}</span>
                                        <span class="top-item-count">{{this.count}} ventes</span>
                                    </div>
                                </div>
                                {{else}}
                                <p style="color:#64748B;font-size:13px;padding:12px;">Aucune donnée de vente pour le moment.</p>
                                {{/each}}
                            </div>
                        </article>

                        <article class="analytics-card">
                            <div class="analytics-card-header">
                                <span class="analytics-card-title">Répartition par catégorie</span>
                            </div>
                            <div class="doughnut-chart-wrapper">
                                <div class="chart-container doughnut-container">
                                    <canvas id="reportCategoryChart"></canvas>
                                </div>
                                <div class="doughnut-legend">
                                    {{#each analytics.categoryDistribution}}
                                    <div class="legend-item">
                                        <div>
                                            <span class="legend-label">{{this.category}}</span>
                                        </div>
                                        <span class="legend-value">{{this.pct}}% ({{this.count}})</span>
                                    </div>
                                    {{/each}}
                                </div>
                            </div>
                        </article>
                    </div>
                </section>
            </main>
        </div>
    </div>

    <script src="/vendor/chartjs/chart.umd.js"></script>
    <script>
        if (typeof Chart === 'undefined') {
            document.write('<script src="https://cdn.jsdelivr.net/npm/chart.js"><\/script>');
        }
    </script>
    <script src="/javascript/index.js"></script>
    <script>
        const analyticsData = {{{json analytics}}} || {};

        window.addEventListener('load', () => {
            if (!analyticsData || typeof Chart === 'undefined') return;

            // Revenue Chart
            const revCanvas = document.getElementById('reportRevenueChart');
            if (revCanvas && analyticsData.revenueByDay) {
                const labels = analyticsData.revenueByDay.map(d => d.day);
                const totals = analyticsData.revenueByDay.map(d => d.total);
                const ctx = revCanvas.getContext('2d');
                const gradient = ctx.createLinearGradient(0, 0, 0, 140);
                gradient.addColorStop(0, 'rgba(249, 115, 22, 0.25)');
                gradient.addColorStop(1, 'rgba(249, 115, 22, 0.0)');

                new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: labels,
                        datasets: [{
                            data: totals,
                            borderColor: '#F97316',
                            borderWidth: 2.5,
                            fill: true,
                            backgroundColor: gradient,
                            tension: 0.4,
                            pointBackgroundColor: '#F97316',
                            pointRadius: 4,
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            x: { grid: { display: false } },
                            y: { grid: { color: '#F1F5F9' } }
                        }
                    }
                });
            }

            // Orders Chart
            const ordCanvas = document.getElementById('reportOrdersChart');
            if (ordCanvas && analyticsData.ordersByDay) {
                const labels = analyticsData.ordersByDay.map(d => d.day);
                const counts = analyticsData.ordersByDay.map(d => d.count);
                const ctx = ordCanvas.getContext('2d');

                new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: labels,
                        datasets: [{
                            data: counts,
                            backgroundColor: '#C084FC',
                            borderRadius: 6,
                            barThickness: 12
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            x: { grid: { display: false } },
                            y: { grid: { color: '#F1F5F9' } }
                        }
                    }
                });
            }

            // Category Chart
            const catCanvas = document.getElementById('reportCategoryChart');
            if (catCanvas && analyticsData.categoryDistribution) {
                const labels = analyticsData.categoryDistribution.map(c => c.category);
                const counts = analyticsData.categoryDistribution.map(c => c.count);
                const colors = ['#F97316', '#8B5CF6', '#F59E0B', '#EC4899', '#3B82F6', '#10B981'];
                const ctx = catCanvas.getContext('2d');

                new Chart(ctx, {
                    type: 'doughnut',
                    data: {
                        labels: labels,
                        datasets: [{
                            data: counts,
                            backgroundColor: colors.slice(0, counts.length),
                            borderWidth: 0
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '70%',
                        plugins: { legend: { display: false } }
                    }
                });
            }
        });

        function openExportModal() {
            const modal = document.getElementById('exportInvoiceModal');
            if (modal) modal.hidden = false;
        }

        function closeExportModal() {
            const modal = document.getElementById('exportInvoiceModal');
            if (modal) modal.hidden = true;
        }
    </script>

    <!-- Modal Export Rapport & Facture -->
    <div class="report-modal" id="exportInvoiceModal" hidden>
        <div class="modal-backdrop" onclick="closeExportModal()"></div>
        <div class="modal-panel" role="dialog" aria-modal="true">
            <div class="modal-header">
                <div>
                    <p style="font-size:11px;font-weight:700;color:#EA580C;text-transform:uppercase;letter-spacing:.05em;margin:0 0 2px 0;">Facture & Rapport de Caisse</p>
                    <h3 style="margin:0;font-size:18px;color:#0F172A;">Rapport Financier Global</h3>
                </div>
                <div style="display:flex;gap:10px;align-items:center;">
                    <button type="button" class="btn btn-primary" onclick="window.print()" style="display:inline-flex;align-items:center;gap:8px;background:#EA580C;color:#fff;border:none;padding:8px 16px;border-radius:8px;font-weight:600;font-size:13px;cursor:pointer;">
                        <i class="fa-solid fa-print"></i> Imprimer / PDF
                    </button>
                    <button type="button" class="modal-close" onclick="closeExportModal()" aria-label="Fermer">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div>
            </div>

            <div class="modal-content">
                <!-- Printable Invoice Content -->
                <div id="printableInvoiceReport" class="invoice-box">
                    <!-- Header / Brand -->
                    <div class="inv-header">
                        <div class="inv-brand">
                            <h2>{{#if restaurantSettings.restaurantName}}{{restaurantSettings.restaurantName}}{{else}}Le Patio Djerba{{/if}}</h2>
                            <p><i class="fa-solid fa-location-dot"></i> {{#if restaurantSettings.address}}{{restaurantSettings.address}}{{else}}Djerba, Tunisie{{/if}}</p>
                            <p><i class="fa-solid fa-phone"></i> {{#if restaurantSettings.phone}}{{restaurantSettings.phone}}{{else}}-{{/if}}</p>
                        </div>
                        <div class="inv-meta">
                            <span class="inv-badge">FACTURE & RAPPORT FINANCIER</span>
                            <p><strong>Généré le:</strong> {{fullReport.reportDate}}</p>
                            <p><strong>Devise:</strong> {{#if restaurantSettings.currency}}{{restaurantSettings.currency}}{{else}}DNT{{/if}}</p>
                        </div>
                    </div>

                    <div class="inv-divider"></div>

                    <!-- Section 1: Ce qu'on a vendu aujourd'hui -->
                    <div class="inv-section">
                        <div class="inv-section-header">
                            <h3><i class="fa-solid fa-receipt"></i> 1. Ventes d'Aujourd'hui (Détail des Plats Vendus)</h3>
                        </div>
                        <table class="inv-table">
                            <thead>
                                <tr>
                                    <th>Désignation / Plat</th>
                                    <th class="text-center">Quantité vendue</th>
                                    <th class="text-right">Prix Unitaire</th>
                                    <th class="text-right">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                {{#each fullReport.todaySoldItems}}
                                <tr>
                                    <td><strong>{{this.name}}</strong></td>
                                    <td class="text-center">{{this.quantity}}</td>
                                    <td class="text-right">{{this.unitPriceFormatted}} {{#if ../restaurantSettings.currency}}{{../restaurantSettings.currency}}{{else}}DNT{{/if}}</td>
                                    <td class="text-right"><strong>{{this.totalFormatted}} {{#if ../restaurantSettings.currency}}{{../restaurantSettings.currency}}{{else}}DNT{{/if}}</strong></td>
                                </tr>
                                {{else}}
                                <tr>
                                    <td colspan="4" class="text-center text-muted" style="padding:16px;">Aucune vente enregistrée aujourd'hui.</td>
                                </tr>
                                {{/each}}
                            </tbody>
                            <tfoot>
                                <tr class="inv-foot-row">
                                    <td colspan="3" class="text-right"><strong>TOTAL VENTES DU JOUR:</strong></td>
                                    <td class="text-right"><strong class="inv-highlight">{{fullReport.revenueTodayFormatted}} {{#if restaurantSettings.currency}}{{restaurantSettings.currency}}{{else}}DNT{{/if}}</strong></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <!-- Section 2: Rapport des ventes par jour -->
                    <div class="inv-section" style="margin-top: 28px;">
                        <div class="inv-section-header">
                            <h3><i class="fa-solid fa-calendar-check"></i> 2. Historique des Ventes par Jour</h3>
                        </div>
                        <table class="inv-table">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th class="text-center">Commandes validées</th>
                                    <th class="text-right">Chiffre d'Affaires du Jour</th>
                                </tr>
                            </thead>
                            <tbody>
                                {{#each fullReport.dailySales}}
                                <tr>
                                    <td><strong>{{this.dayLabel}}</strong> <small style="color:#64748B;">({{this.dateStr}})</small></td>
                                    <td class="text-center">{{this.count}} commande(s)</td>
                                    <td class="text-right"><strong>{{this.revenueFormatted}} {{#if ../restaurantSettings.currency}}{{../restaurantSettings.currency}}{{else}}DNT{{/if}}</strong></td>
                                </tr>
                                {{else}}
                                <tr>
                                    <td colspan="3" class="text-center text-muted" style="padding:16px;">Aucun historique quotidien disponible.</td>
                                </tr>
                                {{/each}}
                            </tbody>
                        </table>
                    </div>

                    <!-- Section 3: Recette Totale Globale (Reset Total) -->
                    <div class="inv-grand-total">
                        <div class="inv-grand-total-content">
                            <span>RECETTE TOTALE GLOBAL CUMULÉE (TOTAL DES VENTES)</span>
                            <h2>{{fullReport.grandTotalRevenueFormatted}} {{#if restaurantSettings.currency}}{{restaurantSettings.currency}}{{else}}DNT{{/if}}</h2>
                            <small>Chiffre d'affaires total généré sur l'ensemble de l'historique ({{fullReport.totalOrdersCount}} commandes au total)</small>
                        </div>
                    </div>

                    <div class="inv-footer">
                        <p>Document officiel généré par DigitalMenu — {{#if restaurantSettings.restaurantName}}{{restaurantSettings.restaurantName}}{{else}}Le Patio Djerba{{/if}}</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <style>
    /* Export Modal Styles */
    .report-modal {
        position: fixed;
        inset: 0;
        z-index: 9999;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }
    .report-modal[hidden] {
        display: none !important;
    }
    .modal-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(15, 23, 42, 0.65);
        backdrop-filter: blur(4px);
    }
    .modal-panel {
        position: relative;
        z-index: 10;
        width: 100%;
        max-width: 840px;
        max-height: 90vh;
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }
    .modal-header {
        padding: 16px 24px;
        border-bottom: 1px solid #E2E8F0;
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: #F8FAFC;
    }
    .modal-content {
        padding: 24px;
        overflow-y: auto;
        background: #F1F5F9;
    }
    .modal-close {
        background: #E2E8F0;
        border: none;
        width: 34px;
        height: 34px;
        border-radius: 8px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #475569;
        transition: all 0.2s;
    }
    .modal-close:hover {
        background: #FECACA;
        color: #EF4444;
    }

    /* Invoice Box Styling */
    .invoice-box {
        background: #fff;
        border-radius: 12px;
        padding: 32px;
        border: 1px solid #E2E8F0;
        box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
    }
    .inv-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
    }
    .inv-brand h2 {
        font-size: 24px;
        font-weight: 800;
        color: #0F172A;
        margin-bottom: 4px;
    }
    .inv-brand p {
        font-size: 13px;
        color: #64748B;
        margin: 2px 0;
    }
    .inv-meta {
        text-align: right;
    }
    .inv-badge {
        display: inline-block;
        background: #FFF7ED;
        color: #EA580C;
        border: 1px solid #FFEDD5;
        font-size: 11px;
        font-weight: 700;
        padding: 4px 10px;
        border-radius: 6px;
        letter-spacing: 0.5px;
        margin-bottom: 8px;
    }
    .inv-meta p {
        font-size: 12px;
        color: #475569;
        margin: 2px 0;
    }
    .inv-divider {
        height: 2px;
        background: linear-gradient(90deg, #F97316 0%, #E2E8F0 100%);
        margin: 24px 0;
        border-radius: 2px;
    }
    .inv-section-header h3 {
        font-size: 15px;
        font-weight: 700;
        color: #1E293B;
        margin-bottom: 12px;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .inv-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
    }
    .inv-table th {
        background: #F8FAFC;
        color: #475569;
        font-weight: 600;
        text-align: left;
        padding: 10px 14px;
        border-bottom: 2px solid #E2E8F0;
    }
    .inv-table td {
        padding: 10px 14px;
        border-bottom: 1px solid #F1F5F9;
        color: #1E293B;
    }
    .inv-table tfoot td {
        border-top: 2px solid #E2E8F0;
        background: #FFF7ED;
        padding: 12px 14px;
    }
    .inv-highlight {
        font-size: 16px;
        color: #EA580C;
    }
    .text-center { text-align: center !important; }
    .text-right { text-align: right !important; }
    .text-muted { color: #94A3B8 !important; }

    /* Grand Total Banner */
    .inv-grand-total {
        margin-top: 28px;
        background: linear-gradient(135deg, #0F172A 0%, #1E293B 100%);
        border-radius: 12px;
        padding: 24px;
        color: #fff;
        text-align: center;
        box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.3);
    }
    .inv-grand-total span {
        font-size: 11px;
        font-weight: 700;
        color: #F97316;
        letter-spacing: 1px;
        text-transform: uppercase;
    }
    .inv-grand-total h2 {
        font-size: 32px;
        font-weight: 800;
        color: #4ADE80;
        margin: 8px 0;
    }
    .inv-grand-total small {
        font-size: 12px;
        color: #94A3B8;
    }
    .inv-footer {
        margin-top: 24px;
        text-align: center;
        font-size: 11px;
        color: #94A3B8;
        border-top: 1px solid #F1F5F9;
        padding-top: 16px;
    }

    /* Print Only Styles */
    @media print {
        body * {
            visibility: hidden !important;
        }
        #printableInvoiceReport, #printableInvoiceReport * {
            visibility: visible !important;
        }
        #printableInvoiceReport {
            position: absolute !important;
            left: 0 !important;
            top: 0 !important;
            width: 100% !important;
            margin: 0 !important;
            padding: 0 !important;
            border: none !important;
            box-shadow: none !important;
        }
        .report-modal {
            position: static !important;
            padding: 0 !important;
        }
        .modal-backdrop, .modal-header {
            display: none !important;
        }
        .modal-panel, .modal-content {
            max-width: 100% !important;
            max-height: none !important;
            box-shadow: none !important;
            background: transparent !important;
            padding: 0 !important;
            overflow: visible !important;
        }
    }
    </style>
</body>
</html>
