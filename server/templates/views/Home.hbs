<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Admin | Dine/Delight</title>
    <link rel="stylesheet" href="/css/admin-theme.css">
    <link rel="stylesheet" href="/css/homepage.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>

<body>
    <div class="main">
        <div class="bigBox">
            {{>Sidebar}}

            <main class="dashboard-page fade-in">
                <!-- Top Header Bar -->
                <header class="main-header">
                    <div class="header-mobile-toggle">
                        <button id="sidebarToggle" class="btn-icon" aria-label="Menu Mobile">
                            <i class="fa-solid fa-bars"></i>
                        </button>
                    </div>

                    <div class="header-welcome">
                        <h1>Bonjour, {{adminName}} <span class="wave-emoji">👋</span></h1>
                        <p class="header-subtitle">Voici un aperçu de votre restaurant aujourd'hui.</p>
                    </div>

                    <div class="header-search">
                        <div class="search-input-wrapper" style="position:relative;">
                            <i class="fa-solid fa-magnifying-glass search-icon"></i>
                            <input type="text" id="globalSearch" placeholder="Rechercher plats, commandes, tables..." aria-label="Rechercher" autocomplete="off">
                            <kbd class="search-kbd">/</kbd>
                            <div class="search-results-dropdown" id="searchResultsDropdown" hidden></div>
                        </div>
                    </div>

                    <div class="header-actions">
                        <div class="notification-wrapper">
                            <button class="btn-icon notification-btn" id="notifBtn" aria-label="Notifications" title="Notifications">
                                <i class="fa-regular fa-bell"></i>
                                <span class="notification-badge" id="notifBadge">{{orders.length}}</span>
                            </button>

                            <div class="notification-dropdown" id="notifDropdown" hidden>
                                <div class="notif-header">
                                    <div style="display:flex;align-items:center;gap:8px;">
                                        <i class="fa-solid fa-bell" style="color:#F97316;"></i>
                                        <strong style="font-size:14px;color:#0F172A;">Notifications en direct</strong>
                                    </div>
                                    <span class="notif-count-pill" id="notifCountPill">{{orders.length}} nouvelles</span>
                                </div>
                                <div class="notif-list" id="notifList">
                                    {{#each orders}}
                                    <a href="/Orders" class="notif-item" style="display:flex;align-items:center;gap:12px;padding:12px 16px;border-bottom:1px solid #F1F5F9;text-decoration:none;">
                                        <div style="width:36px;height:36px;border-radius:10px;background:#FFF7ED;color:#EA580C;display:grid;place-items:center;font-size:14px;flex-shrink:0;">
                                            <i class="fa-solid fa-bag-shopping"></i>
                                        </div>
                                        <div style="flex:1;font-size:12px;">
                                            <div style="color:#0F172A;font-weight:600;">Commande <strong>#{{#if this._id}}{{this._id}}{{/if}}</strong></div>
                                            <div style="color:#64748B;font-size:11px;margin-top:2px;">
                                                <span>{{#if this.name}}{{this.name}}{{else}}Client{{/if}}</span> • <strong style="color:#16A34A;">{{this.totalPrice}} DNT</strong>
                                            </div>
                                        </div>
                                    </a>
                                    {{else}}
                                    <div style="padding:20px;text-align:center;color:#64748B;font-size:13px;">Aucune notification récente</div>
                                    {{/each}}
                                </div>
                                <div class="notif-footer">
                                    <a href="/Orders" class="notif-footer-link">Voir toutes les commandes ➔</a>
                                </div>
                            </div>
                        </div>

                        <div class="header-user-profile" title="Profil Admin">
                            <img src="/images/Admin_image.png" alt="Avatar Admin" class="header-user-avatar">
                            <div class="header-user-details">
                                <span class="header-user-name">{{adminName}}</span>
                                <span class="header-user-role">Admin</span>
                            </div>
                        </div>

                        <div class="header-date-picker">
                            <i class="fa-regular fa-calendar date-icon"></i>
                            <input type="date" id="date" class="date-input">
                            <i class="fa-solid fa-chevron-down date-chevron"></i>
                        </div>
                    </div>
                </header>

                <!-- Statistics Cards (4 Cards Grid) -->
                <section class="stats-grid" aria-label="Chiffres clés">
                    <article class="stat-card stat-card-orange fade-in-1">
                        <div class="stat-icon-wrapper">
                            <i class="fa-solid fa-chart-line"></i>
                        </div>
                        <div class="stat-info">
                            <span class="stat-label">MENU ITEMS</span>
                            <h3 class="stat-value" id="menuItemCount">0</h3>
                            <div class="stat-trend is-flat">
                                <span class="stat-trend-period">Total actif</span>
                            </div>
                        </div>
                    </article>

                    <article class="stat-card stat-card-purple fade-in-2">
                        <div class="stat-icon-wrapper">
                            <i class="fa-solid fa-gift"></i>
                        </div>
                        <div class="stat-info">
                            <span class="stat-label">CATEGORIES</span>
                            <h3 class="stat-value" id="categoryCount">{{#if categoryCount}}{{categoryCount}}{{else}}0{{/if}}</h3>
                            <div class="stat-trend is-flat">
                                <span class="stat-trend-period">Total actif</span>
                            </div>
                        </div>
                    </article>

                    <article class="stat-card stat-card-pink fade-in-3">
                        <div class="stat-icon-wrapper">
                            <i class="fa-solid fa-basket-shopping"></i>
                        </div>
                        <div class="stat-info">
                            <span class="stat-label">ORDERS</span>
                            <h3 class="stat-value" id="orderCount">0</h3>
                            <div class="stat-trend is-flat" id="orderStatTrend">
                                <span class="stat-trend-period">vs hier</span>
                            </div>
                        </div>
                    </article>

                    <article class="stat-card stat-card-green fade-in-4">
                        <div class="stat-icon-wrapper">
                            <i class="fa-solid fa-dollar-sign"></i>
                        </div>
                        <div class="stat-info">
                            <span class="stat-label">REVENUE (AUJ.)</span>
                            <h3 class="stat-value" id="revenueTodayDisplay">{{analytics.revenueToday}} DNT</h3>
                            <div class="stat-trend is-flat" id="revenueStatTrend">
                                <span class="stat-trend-period">vs hier</span>
                            </div>
                        </div>
                    </article>
                </section>

                <!-- Analytics Section ("Aperçu Analytique") -->
                <section class="analytics-section">
                    <div class="section-header">
                        <h2>Aperçu Analytique</h2>
                    </div>

                    <div class="analytics-grid">
                        <!-- Chart 1: Revenue Overview -->
                        <article class="analytics-card">
                            <div class="analytics-card-header">
                                <div>
                                    <span class="analytics-card-title">Revenus</span>
                                    <div class="analytics-card-metric">
                                        <span class="metric-value" id="revenueWeekMetric">0 DNT</span>
                                        <span class="metric-trend is-flat" id="revenueWeekTrend"></span>
                                    </div>
                                </div>
                                <select class="analytics-period-select" aria-label="Période Revenus">
                                    <option>Cette semaine</option>
                                    <option>Ce mois</option>
                                </select>
                            </div>
                            <div class="chart-container">
                                <canvas id="revenueChart"></canvas>
                            </div>
                        </article>

                        <!-- Chart 2: Orders Per Day -->
                        <article class="analytics-card">
                            <div class="analytics-card-header">
                                <div>
                                    <span class="analytics-card-title">Commandes par jour</span>
                                    <div class="analytics-card-metric">
                                        <span class="metric-value" id="ordersWeekMetric">0</span>
                                        <span class="metric-trend is-flat" id="ordersWeekTrend"></span>
                                    </div>
                                </div>
                                <select class="analytics-period-select" aria-label="Période Commandes">
                                    <option>Cette semaine</option>
                                    <option>Ce mois</option>
                                </select>
                            </div>
                            <div class="chart-container">
                                <canvas id="ordersChart"></canvas>
                            </div>
                        </article>

                        <!-- Chart 3: Top Menu Items -->
                        <article class="analytics-card">
                            <div class="analytics-card-header">
                                <div>
                                    <span class="analytics-card-title">Top plats</span>
                                </div>
                                <select class="analytics-period-select" aria-label="Période Top Plats">
                                    <option>Cette semaine</option>
                                    <option>Ce mois</option>
                                </select>
                            </div>
                            <div class="top-items-list" id="topItemsList"></div>
                        </article>

                        <!-- Chart 4: Popular Categories -->
                        <article class="analytics-card">
                            <div class="analytics-card-header">
                                <span class="analytics-card-title">Catégories populaires</span>
                            </div>
                            <div class="doughnut-chart-wrapper">
                                <div class="chart-container doughnut-container">
                                    <canvas id="categoryChart"></canvas>
                                </div>
                                <div class="doughnut-legend" id="categoryLegend"></div>
                            </div>
                        </article>
                    </div>
                </section>

                <!-- Bottom Section: Recent Orders & Quick Access QR Card -->
                <div class="dashboard-bottom-grid">
                    <!-- Recent Orders Table -->
                    <section class="orders-card">
                        <div class="orders-card-header">
                            <h2>Dernières commandes</h2>
                            <a href="/Orders" class="btn btn-ghost btn-sm">Voir tout</a>
                        </div>

                        <div class="orders-table-wrapper" aria-label="Table des dernières commandes">
                            {{#if hasOrders}}
                            <table class="orders-table">
                                <thead>
                                    <tr>
                                        <th>TABLE</th>
                                        <th>CLIENT</th>
                                        <th>ARTICLES</th>
                                        <th>MONTANT</th>
                                        <th>STATUT</th>
                                        <th>HEURE</th>
                                        <th>ACTIONS</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {{#each orders}}
                                    <tr>
                                        <td><strong>{{#if TableNumber}}Table {{TableNumber}}{{else}}Reservation{{/if}}</strong></td>
                                        <td>{{name}}</td>
                                        <td style="color: #64748B;">
                                            {{#each items}}
                                            {{this.itemName}}{{#unless @last}}, {{/unless}}
                                            {{/each}}
                                        </td>
                                        <td><strong>{{totalPrice}} DNT</strong></td>
                                        <td>
                                            <span class="badge badge-{{status}}">
                                                <i class="fa-solid fa-circle" style="font-size: 6px;"></i> {{status}}
                                            </span>
                                        </td>
                                        <td style="color: #64748B; font-size: 12px;">{{formatTime createdAt}}</td>
                                        <td>
                                            <a class="btn-action-eye" href="/Orders" title="Voir détails">
                                                <i class="fa-regular fa-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                    {{/each}}
                                </tbody>
                            </table>
                            {{else}}
                            <div class="admin-empty">
                                <i class="fa-solid fa-receipt"></i>
                                <p class="admin-title" style="font-size: 14px;">Pas encore de commandes</p>
                                <p class="admin-subtitle" style="font-size: 12px;">Les nouvelles commandes apparaitront ici.</p>
                            </div>
                            {{/if}}
                        </div>
                    </section>

                    <!-- QR Code Section Card -->
                    <section class="qr-quick-card">
                        <div class="qr-card-header">
                            <h2>Accès rapide</h2>
                        </div>

                        <div class="qr-card-body">
                            <div class="qr-menu-title">
                                <h3>QR Menu</h3>
                                <p>Scannez pour voir le menu</p>
                            </div>

                            <div class="qr-code-display-box">
                                <div class="updates12"></div>
                            </div>

                            <div class="qr-url-copy-row">
                                <input type="text" id="qrUrlInput" readonly class="qr-url-input">
                                <button id="copyQrUrlBtn" class="btn-icon-square" title="Copier le lien" type="button">
                                    <i class="fa-regular fa-copy"></i>
                                </button>
                            </div>

                            <div class="qr-actions-row">
                                <button id="downloadQrBtn" class="btn btn-primary btn-block" type="button">
                                    <i class="fa-solid fa-download"></i>
                                    Télécharger
                                </button>
                                <button id="shareQrBtn" class="btn btn-ghost btn-block" type="button">
                                    <i class="fa-solid fa-share-nodes"></i>
                                    Partager
                                </button>
                            </div>
                        </div>
                    </section>
                </div>

                <!-- Main Footer -->
                <footer class="main-footer">
                    <p>© 2026 Dine/Delight. Tous droits réservés.</p>
                    <p>Version 2.0.0</p>
                </footer>
            </main>
        </div>
    </div>

    <!-- Scripts -->
    <script>window.__DASHBOARD_ANALYTICS__ = {{{json analytics}}};</script>
    <script src="/vendor/qrious/qrious.min.js"></script>
    <script src="/vendor/chartjs/chart.umd.js"></script>
    <script>
        if (typeof Chart === 'undefined') {
            document.write('<script src="https://cdn.jsdelivr.net/npm/chart.js"><\/script>');
        }
    </script>
    <script src="/javascript/dashboard-charts.js"></script>
    <script src="/javascript/index.js"></script>
    <script>
        // Set today's date in header date picker
        const dateInput = document.getElementById('date');
        if (dateInput) {
            dateInput.valueAsDate = new Date();
        }

        // Fetch counts from existing backend endpoints
        const updateCount = (id, count) => {
            const el = document.getElementById(id);
            if (el && count !== undefined) {
                el.innerText = count;
            }
        };

        fetch('/getMenuItemCount')
            .then(res => res.json())
            .then(data => updateCount('menuItemCount', data.menuItemCount))
            .catch(() => {});

        fetch('/getCategoryCount')
            .then(res => res.json())
            .then(data => updateCount('categoryCount', data.categoryCount))
            .catch(() => {});

        fetch('/getorderCount')
            .then(res => res.json())
            .then(data => updateCount('orderCount', data.OrderCount))
            .catch(() => {});

        // QR Code Generator & Actions
        function initQRCode() {
            if (typeof QRious === 'undefined') return;

            const qrUrl = window.location.origin + '/UserMenu';
            const canvas = document.createElement('canvas');
            new QRious({
                element: canvas,
                size: 180,
                level: 'H',
                value: qrUrl,
            });

            const qrSlot = document.querySelector('.updates12');
            if (qrSlot) {
                qrSlot.innerHTML = '';
                qrSlot.appendChild(canvas);
            }

            const urlInput = document.getElementById('qrUrlInput');
            if (urlInput) {
                urlInput.value = qrUrl;
            }

            // Copy Link
            const copyBtn = document.getElementById('copyQrUrlBtn');
            if (copyBtn) {
                copyBtn.addEventListener('click', () => {
                    navigator.clipboard.writeText(urlInput ? urlInput.value : qrUrl).then(() => {
                        showToast('Lien copié dans le presse-papier !');
                    });
                });
            }

            // Download QR Image
            const downloadBtn = document.getElementById('downloadQrBtn');
            if (downloadBtn) {
                downloadBtn.addEventListener('click', () => {
                    const link = document.createElement('a');
                    link.download = 'menu-qr-code.png';
                    link.href = canvas.toDataURL('image/png');
                    link.click();
                    showToast('Téléchargement du QR Code lancé.');
                });
            }

            // Share QR
            const shareBtn = document.getElementById('shareQrBtn');
            if (shareBtn) {
                shareBtn.addEventListener('click', () => {
                    if (navigator.share) {
                        navigator.share({
                            title: 'Menu QR Code Dine/Delight',
                            url: urlInput ? urlInput.value : qrUrl
                        }).catch(() => {});
                    } else {
                        navigator.clipboard.writeText(urlInput ? urlInput.value : qrUrl).then(() => {
                            showToast('Lien copié pour le partage !');
                        });
                    }
                });
            }
        }

        function showToast(message) {
            let toast = document.querySelector('.toast-notification');
            if (!toast) {
                toast = document.createElement('div');
                toast.className = 'toast-notification';
                document.body.appendChild(toast);
            }
            toast.innerHTML = `<i class="fa-solid fa-circle-check" style="color: #22C55E;"></i> ${message}`;
            toast.classList.add('show');
            setTimeout(() => {
                toast.classList.remove('show');
            }, 2500);
        }

        function escapeHtml(value) {
            return String(value || '')
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        // ── 🔔 Notification & 🔍 Search Dropdown Logic ───────────────────
        document.addEventListener('DOMContentLoaded', () => {
            const notifBtn = document.getElementById('notifBtn');
            const notifDropdown = document.getElementById('notifDropdown');

            if (notifBtn && notifDropdown) {
                notifBtn.addEventListener('click', async (e) => {
                    e.stopPropagation();
                    const isHidden = notifDropdown.hidden;
                    notifDropdown.hidden = !isHidden;

                    if (isHidden) {
                        try {
                            const res = await fetch('/api/notifications');
                            const data = await res.json();
                            if (data.success && data.notifications) {
                                const listEl = document.getElementById('notifList');
                                const badgeEl = document.getElementById('notifBadge');
                                const countPill = document.getElementById('notifCountPill');

                                if (badgeEl) badgeEl.textContent = data.count;
                                if (countPill) countPill.textContent = `${data.count} récentes`;

                                if (data.notifications.length > 0) {
                                    listEl.innerHTML = data.notifications.map(n => `
                                        <a href="/Orders" class="notif-item" style="display:flex;align-items:center;gap:12px;padding:12px 16px;border-bottom:1px solid #F1F5F9;text-decoration:none;">
                                            <div style="width:36px;height:36px;border-radius:10px;background:#FFF7ED;color:#EA580C;display:grid;place-items:center;font-size:14px;flex-shrink:0;">
                                                <i class="fa-solid fa-bag-shopping"></i>
                                            </div>
                                            <div style="flex:1;font-size:12px;">
                                                <div style="color:#0F172A;font-weight:600;">Commande <strong>#${escapeHtml(n.orderIdDisplay)}</strong></div>
                                                <div style="color:#64748B;font-size:11px;margin-top:2px;">
                                                    <span>${escapeHtml(n.name)} (${escapeHtml(n.serviceType)})</span> • <strong style="color:#16A34A;">${escapeHtml(n.totalPrice)} DNT</strong> <span style="margin-left:4px;color:#94A3B8;">${escapeHtml(n.time)}</span>
                                                </div>
                                            </div>
                                        </a>
                                    `).join('');
                                } else {
                                    listEl.innerHTML = `<div style="padding:20px;text-align:center;color:#64748B;font-size:13px;">Aucune notification récente</div>`;
                                }
                            }
                        } catch(err) {
                            console.error('Error fetching notifications:', err);
                        }
                    }
                });

                document.addEventListener('click', (e) => {
                    if (notifDropdown && !notifDropdown.contains(e.target) && !notifBtn.contains(e.target)) {
                        notifDropdown.hidden = true;
                    }
                });
            }

            // ── 🔍 Live Global Search Logic ──────────────────────────────────
            const globalSearchInput = document.getElementById('globalSearch');
            const searchDropdown = document.getElementById('searchResultsDropdown');

            let searchDebounce = null;
            if (globalSearchInput && searchDropdown) {
                globalSearchInput.addEventListener('input', () => {
                    clearTimeout(searchDebounce);
                    const query = globalSearchInput.value.trim();

                    if (query.length < 1) {
                        searchDropdown.hidden = true;
                        return;
                    }

                    searchDebounce = setTimeout(async () => {
                        try {
                            const res = await fetch(`/api/search?q=${encodeURIComponent(query)}`);
                            const data = await res.json();

                            if (!data.success || (!data.dishes.length && !data.orders.length && !data.categories.length)) {
                                searchDropdown.innerHTML = `<div style="padding:16px;text-align:center;color:#64748B;font-size:12px;">Aucun résultat pour "${escapeHtml(query)}"</div>`;
                                searchDropdown.hidden = false;
                                return;
                            }

                            let html = '';

                            if (data.orders.length > 0) {
                                html += `<div class="search-group-title">🛒 Commandes (${data.orders.length})</div>`;
                                html += data.orders.map(o => `
                                    <a href="/Orders" class="search-result-item">
                                        <div style="width:32px;height:32px;border-radius:8px;background:#FFF7ED;color:#EA580C;display:grid;place-items:center;font-size:12px;flex-shrink:0;">
                                            <i class="fa-solid fa-bag-shopping"></i>
                                        </div>
                                        <div style="flex:1;">
                                            <div class="search-result-title">Commande <strong>#${escapeHtml(o.orderIdDisplay)}</strong> (${escapeHtml(o.name)})</div>
                                            <div class="search-result-subtitle">${escapeHtml(o.date)} • <strong style="color:#16A34A;">${escapeHtml(o.totalPrice)} DNT</strong></div>
                                        </div>
                                    </a>
                                `).join('');
                            }

                            if (data.dishes.length > 0) {
                                html += `<div class="search-group-title">🍔 Plats du Menu (${data.dishes.length})</div>`;
                                html += data.dishes.map(d => `
                                    <a href="/Menu_Dishes" class="search-result-item">
                                        <img src="${escapeHtml(d.imageUrl)}" alt="${escapeHtml(d.title)}" style="width:32px;height:32px;border-radius:8px;object-fit:cover;" onerror="this.src='/images/Admin_image.png'">
                                        <div style="flex:1;">
                                            <div class="search-result-title">${escapeHtml(d.title)}</div>
                                            <div class="search-result-subtitle">${escapeHtml(d.category)} • <strong style="color:#B8975A;">${escapeHtml(d.price)} DNT</strong></div>
                                        </div>
                                    </a>
                                `).join('');
                            }

                            if (data.categories.length > 0) {
                                html += `<div class="search-group-title">📁 Catégories (${data.categories.length})</div>`;
                                html += data.categories.map(c => `
                                    <a href="/Categories" class="search-result-item">
                                        <div style="width:32px;height:32px;border-radius:8px;background:#F1F5F9;color:#475569;display:grid;place-items:center;font-size:12px;flex-shrink:0;">
                                            <i class="fa-solid fa-layer-group"></i>
                                        </div>
                                        <div style="flex:1;">
                                            <div class="search-result-title">${escapeHtml(c.name)}</div>
                                        </div>
                                    </a>
                                `).join('');
                            }

                            searchDropdown.innerHTML = html;
                            searchDropdown.hidden = false;
                        } catch(e) {
                            console.error('Search error:', e);
                        }
                    }, 200);
                });

                document.addEventListener('click', (e) => {
                    if (!searchDropdown.contains(e.target) && !globalSearchInput.contains(e.target)) {
                        searchDropdown.hidden = true;
                    }
                });
            }
        });

        window.addEventListener('load', () => {
            initQRCode();
            if (typeof initDashboardCharts === 'function') {
                initDashboardCharts();
            }
        });
    </script>
</body>

</html>
