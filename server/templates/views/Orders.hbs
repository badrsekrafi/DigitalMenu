<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Commandes | Dine/Delight</title>
    <link rel="stylesheet" href="/css/admin-theme.css">
    <link rel="stylesheet" href="/css/Orders.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body>
    <div class="main">
        <div class="bigBox">
            {{>Sidebar}}
            <main class="boxes fade-in">
                <section class="upperbox">
                    <div class="upperbox-text">
                        <p class="eyebrow">Activité en direct</p>
                        <h1>Commandes Clientèle</h1>
                    </div>
                    <div class="upperbox-actions">
                        <span class="badge badge-paid" style="padding: 8px 16px; font-size: 13px; gap: 8px;">
                            <i class="fa-solid fa-bell-concierge"></i> {{orders.length}} Commandes
                        </span>
                    </div>
                </section>

                <section class="lowerbox">
                    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;">
                        <div>
                            <p class="eyebrow">Historique & Suivi</p>
                            <h4>Liste des commandes</h4>
                        </div>
                    </div>
                    <div class="lowerbox-table">
                        <table>
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Date</th>
                                    <th>Nom</th>
                                    <th>Téléphone</th>
                                    <th>Email</th>
                                    <th>Type</th>
                                    <th>Places</th>
                                    <th>Table</th>
                                    <th>Réservation</th>
                                    <th>Commentaire</th>
                                    <th>Articles</th>
                                    <th>Montant</th>
                                    <th>Statut</th>
                                    <th>Détails</th>
                                </tr>
                            </thead>
                            <tbody>
                                {{#each orders}}
                                <tr>
                                    <td data-label="ID"><code style="font-size:11px;background:#F1F5F9;padding:2px 6px;border-radius:4px;">{{orderIdDisplay}}</code></td>
                                    <td data-label="Date" style="color:#64748B;font-size:12px;white-space:nowrap;">{{createdAtDisplay}}</td>
                                    <td data-label="Nom"><strong style="font-size:13px;">{{name}}</strong></td>
                                    <td data-label="Téléphone" style="color:#64748B;font-size:12px;">
                                        {{PhoneNumber}}
                                        {{#if whatsappLink}}
                                        <a href="{{whatsappLink}}" target="_blank" rel="noopener noreferrer" title="Envoyer un WhatsApp au client" style="color:#25D366;font-size:15px;margin-left:6px;text-decoration:none;display:inline-block;vertical-align:middle;">
                                            <i class="fa-brands fa-whatsapp"></i>
                                        </a>
                                        {{/if}}
                                    </td>
                                    <td data-label="Email" style="color:#64748B;font-size:12px;">{{email}}</td>
                                    <td data-label="Type"><span class="order-type {{serviceTypeClass}}">{{serviceTypeLabel}}</span></td>
                                    <td data-label="Places" style="color:#64748B;">{{seatCount}}</td>
                                    <td data-label="Table" style="font-weight:600;">{{tableDisplay}}</td>
                                    <td data-label="Réservation" style="color:#64748B;font-size:12px;">{{reservationLabel}}</td>
                                    <td data-label="Commentaire" class="comment-cell">{{commentDisplay}}</td>
                                    <td data-label="Articles" class="items-cell">
                                        <div class="item-status-list">
                                        {{#each items}}
                                            <div class="item-status-row" data-order-id="{{orderId}}" data-item-index="{{itemIndex}}">
                                                <span class="item-status-name">{{this.itemName}}</span>
                                                <span class="item-status-pill {{statusClass}}">{{statusLabel}}</span>
                                                <select class="item-status-select" data-order-id="{{orderId}}"
                                                    data-item-index="{{itemIndex}}" data-current-status="{{status}}"
                                                    aria-label="Statut pour {{this.itemName}}">
                                                    {{#each statusOptions}}
                                                    <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                                                    {{/each}}
                                                </select>
                                                <button type="button" class="item-remove-btn"
                                                    data-order-id="{{orderId}}" data-item-index="{{itemIndex}}"
                                                    data-item-name="{{this.itemName}}"
                                                    title="Supprimer cet article" aria-label="Supprimer {{this.itemName}}">
                                                    <i class="fa-solid fa-trash-can"></i>
                                                </button>
                                            </div>
                                        {{/each}}
                                        </div>
                                    </td>
                                    <td data-label="Montant"><strong class="order-total-cell" data-order-id="{{_id}}" style="color:#16A34A;">{{totalPriceDisplay}} DNT</strong></td>
                                    <td data-label="Statut"><span class="order-status">{{statusLabel}}</span></td>
                                    <td data-label="Détails">
                                        <button type="button" class="details-button">Voir tout</button>
                                    </td>
                                </tr>
                                {{/each}}
                            </tbody>
                        </table>
                    </div>
                </section>
            </main>
        </div>
    </div>

    <div class="order-modal" id="orderDetailsModal" hidden>
        <div class="modal-backdrop" data-close-modal></div>
        <section class="modal-panel" role="dialog" aria-modal="true" aria-labelledby="orderDetailsTitle">
            <div class="modal-header">
                <div>
                    <p style="font-size:11px;font-weight:600;color:#F97316;text-transform:uppercase;letter-spacing:.05em;">Commande</p>
                    <h3 id="orderDetailsTitle">Détails de la commande</h3>
                </div>
                <button type="button" class="modal-close" data-close-modal aria-label="Fermer">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <div class="modal-content" id="orderDetailsContent"></div>
        </section>
    </div>

    <script src="/javascript/index.js"></script>
    <script>
        const orderDetailsModal = document.getElementById('orderDetailsModal');
        const orderDetailsContent = document.getElementById('orderDetailsContent');

        function closeOrderModal() {
            orderDetailsModal.hidden = true;
            document.body.classList.remove('modal-open');
        }

        function escapeHtml(value) {
            return String(value)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        document.querySelectorAll('.details-button').forEach((button) => {
            button.addEventListener('click', () => {
                const row = button.closest('tr');
                const details = Array.from(row.querySelectorAll('td[data-label]'))
                    .filter((cell) => cell.dataset.label !== 'Détails')
                    .map((cell) => ({
                        label: cell.dataset.label,
                        value: cell.innerText.trim() || '-',
                    }));

                orderDetailsContent.innerHTML = details.map((detail) => `
                    <div class="detail-line">
                        <span>${escapeHtml(detail.label)}</span>
                        <strong>${escapeHtml(detail.value)}</strong>
                    </div>
                `).join('');

                orderDetailsModal.hidden = false;
                document.body.classList.add('modal-open');
            });
        });

        document.querySelectorAll('[data-close-modal]').forEach((button) => {
            button.addEventListener('click', closeOrderModal);
        });

        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape' && !orderDetailsModal.hidden) {
                closeOrderModal();
            }
        });

        // ── Helper: permanently delete item from order ──────────────────
        async function removeOrderItem(orderId, itemIndex, rowEl, trEl) {
            try {
                const response = await fetch(
                    `/orders/${encodeURIComponent(orderId)}/items/${encodeURIComponent(itemIndex)}`,
                    { method: 'DELETE', headers: { 'Accept': 'application/json' } }
                );
                const data = await response.json();
                if (!response.ok || !data.success) throw new Error(data.error || 'Erreur serveur.');

                if (data.orderDeleted) {
                    // Whole order gone → remove the entire table row
                    trEl.remove();
                } else {
                    if (data.newTotalPrice !== undefined) {
                        updateTotalCell(trEl, data.newTotalPrice);
                    }
                    // Just remove this item row with animation
                    rowEl.style.transition = 'opacity 0.3s, max-height 0.3s';
                    rowEl.style.opacity = '0';
                    rowEl.style.maxHeight = '0';
                    rowEl.style.overflow = 'hidden';
                    setTimeout(() => rowEl.remove(), 320);

                    // Re-index remaining item rows in this order so indices stay correct
                    const list = trEl.querySelector('.item-status-list');
                    if (list) {
                        list.querySelectorAll('.item-status-row').forEach((r, newIdx) => {
                            r.dataset.itemIndex = newIdx;
                            r.querySelectorAll('[data-item-index]').forEach(el => el.dataset.itemIndex = newIdx);
                        });
                    }
                }
            } catch (err) {
                alert(err.message || 'Impossible de supprimer l\'article.');
            }
        }

        // ── Helper: update the total price cell for an order row ──────────
        function updateTotalCell(tr, newTotal) {
            const cell = tr.querySelector('.order-total-cell');
            if (cell) cell.textContent = `${parseFloat(newTotal).toFixed(2)} DNT`;
        }

        // ── Status select ─────────────────────────────────────────────────
        document.querySelectorAll('.item-status-select').forEach((select) => {
            select.addEventListener('change', async () => {
                const previousStatus = select.dataset.currentStatus;
                const row  = select.closest('.item-status-row');
                const tr   = select.closest('tr');
                const pill = row.querySelector('.item-status-pill');
                select.disabled = true;

                try {
                    const response = await fetch(
                        `/orders/${encodeURIComponent(select.dataset.orderId)}/items/${encodeURIComponent(select.dataset.itemIndex)}/status`,
                        {
                            method: 'PATCH',
                            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                            body: JSON.stringify({ status: select.value }),
                        }
                    );
                    const data = await response.json();
                    if (!response.ok || !data.success) throw new Error(data.error || 'Erreur.');

                    select.dataset.currentStatus = data.item.status;
                    pill.className = `item-status-pill ${data.item.statusClass}`;
                    pill.textContent = data.item.statusLabel;

                    // Update total price in the row live
                    if (data.newTotalPrice !== undefined) {
                        updateTotalCell(tr, data.newTotalPrice);
                    }

                    // If cancelled: visually strike-through item name
                    const nameEl = row.querySelector('.item-status-name');
                    if (nameEl) {
                        nameEl.style.textDecoration = data.item.status === 'cancel' ? 'line-through' : '';
                        nameEl.style.opacity = data.item.status === 'cancel' ? '0.45' : '';
                    }

                } catch (error) {
                    select.value = previousStatus;
                    alert(error.message || 'Impossible de mettre à jour le statut.');
                } finally {
                    select.disabled = false;
                }
            });
        });

        // ── Trash button: permanent delete ────────────────────────────────
        document.querySelectorAll('.item-remove-btn').forEach((btn) => {
            btn.addEventListener('click', async () => {
                const row  = btn.closest('.item-status-row');
                const tr   = btn.closest('tr');
                const name = btn.dataset.itemName || 'cet article';
                if (!confirm(`Supprimer définitivement "${name}" de la commande ?`)) return;
                btn.disabled = true;
                await removeOrderItem(btn.dataset.orderId, btn.dataset.itemIndex, row, tr);
            });
        });
    </script>

</body>
</html>
