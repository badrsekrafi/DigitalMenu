<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="theme-color" content="#102B43">
    <link rel="icon" type="image/png" href="/images/logo.png">
    <title>{{#if activeUniverse}}{{activeUniverse.label}} · {{/if}}Le Patio Djerba - Menu</title>
    <!-- SEO -->
    <meta name="description" content="Menu digital du restaurant {{#if restaurantSettings.restaurantName}}{{restaurantSettings.restaurantName}}{{else}}Le Patio Djerba{{/if}} — petit déjeuner, plats, douceurs et boissons. Commandez en ligne depuis votre table.">
    <meta name="robots" content="index, follow">
    <!-- Open Graph (partage réseaux sociaux) -->
    <meta property="og:type" content="website">
    <meta property="og:title" content="{{#if restaurantSettings.restaurantName}}{{restaurantSettings.restaurantName}}{{else}}Le Patio Djerba{{/if}} — Notre Menu">
    <meta property="og:description" content="Découvrez nos saveurs et commandez en ligne.">
    <meta property="og:url" content="https://lepatio-djerba.vercel.app/UserMenu">
    <meta property="og:image" content="https://lepatio-djerba.vercel.app/images/patio/hero-djerba.jpg">

    <!-- Fonts: Playfair Display (titles) + DM Sans (text) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&family=Playfair+Display:wght@500;600;700&display=swap">
    <!-- icons: font awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css">
    <link rel="stylesheet" href="/css/patio-menu.css">
    <link rel="preload" as="image" href="{{#if activeUniverse}}{{activeUniverse.cover}}{{else}}/images/patio/le-patio-terrasse.jpg{{/if}}">
    <script>
        window.RESTAURANT_CURRENCY = "{{#if currencyLabel}}{{currencyLabel}}{{else}}DT{{/if}}";
        window.RESTAURANT_NAME = "Le Patio Djerba";
    </script>
    <link rel="stylesheet" href="/css/patio-brand.css">
</head>

<body class="patio" data-initial-view="{{#if activeUniverse}}{{activeUniverse.slug}}{{else}}home{{/if}}">
    <a class="skip-link" href="#main" data-i18n="skipToContent">Aller au contenu</a>

    <main id="main" class="patio-main">

        <!-- ═══════════════════════ VIEW : NOTRE MENU (home) ═══════════════════════ -->
        <section class="view view-home" id="view-home" data-view="home" {{#if activeUniverse}}hidden{{/if}} aria-labelledby="homeTitle">
            <header class="patio-header">
                <a class="brand" href="/UserMenu" data-nav-home>
                    <span class="brand-logo"><img src="/images/logo.png" alt="" width="44" height="44"></span>
                    <span class="brand-text">
                        <strong>Le Patio Djerba</strong>
                        <small data-i18n="tagline">Découvrez nos saveurs</small>
                    </span>
                </a>
                <div class="header-actions">
                    <button type="button" class="icon-btn" data-search-open aria-label="Rechercher un produit" data-i18n-aria="search">
                        <i class="fas fa-search" aria-hidden="true"></i>
                    </button>
                    <button type="button" class="icon-btn" data-drawer-open aria-controls="navDrawer" aria-expanded="false" aria-label="Ouvrir le menu de navigation" data-i18n-aria="openNav">
                        <i class="fas fa-bars" aria-hidden="true"></i>
                    </button>
                </div>
            </header>

            <div class="hero">
                <img class="hero-img" src="/images/patio/le-patio-terrasse.jpg"
                    alt="La terrasse du Patio Café & Drinks à Djerba" width="1205" height="1306" fetchpriority="high">
                <div class="hero-shade" aria-hidden="true"></div>
                <div class="hero-caption">
                    <span class="hero-chip"><i class="fas fa-map-marker-alt" aria-hidden="true"></i> Houmt Souk · Djerba</span>
                    <p class="hero-welcome" data-i18n="welcome">Bienvenue au Patio</p>
                </div>
            </div>

            <div class="home-intro">
                <span class="ornament" aria-hidden="true"><i></i><b></b><i></i></span>
                <h1 id="homeTitle" data-i18n="ourMenu">Notre Menu</h1>
                <p data-i18n="ourMenuSub">Découvrez nos spécialités et choisissez votre catégorie</p>
            </div>

            <div class="table-context" id="tableContext" hidden>
                <span class="table-context-icon" aria-hidden="true"><i class="fas fa-chair"></i></span>
                <div class="table-context-text">
                    <p id="tableContextKicker">Commande sur place</p>
                    <strong id="tableContextLabel">Choisissez votre table</strong>
                </div>
                <label id="tableSelectorWrap" for="userMenuTableSelect">
                    <span class="visually-hidden">Table</span>
                    <select id="userMenuTableSelect">
                        <option value="">Table…</option>
                        {{#each tables}}
                        <option value="{{number}}">Table {{number}} · {{seats}} places</option>
                        {{/each}}
                    </select>
                </label>
            </div>

            <div class="client-order-status" id="clientOrderStatus" hidden>
                <div class="client-order-status-title">
                    <div>
                        <p data-i18n="orderStatus">Suivi commande</p>
                        <strong data-i18n="itemStatus">Statut des articles</strong>
                    </div>
                    <div class="client-order-status-actions">
                        <span id="clientOrderStatusCount">0 article</span>
                        <button type="button" class="status-close-button" id="clientOrderStatusClose" aria-label="Masquer le suivi commande">
                            <i class="fas fa-times" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>
                <div class="client-order-status-list" id="clientOrderStatusList"></div>
                <div class="client-order-status-footer">
                    <button type="button" class="btn-ghost-gold" onclick="openRatingModal()">
                        <i class="fas fa-star" aria-hidden="true"></i> <span data-i18n="rateExperience">Évaluer votre expérience</span>
                    </button>
                </div>
            </div>

            {{#if dailyOfferItems.length}}
            <section class="daily-offers" aria-labelledby="dailyOfferTitle" data-offer-day="{{offerDay}}">
                <div class="daily-offers-heading">
                    <div><p class="menu-kicker" data-i18n="dailyOfferKicker">La sélection du Patio</p>
                    <h2 id="dailyOfferTitle" data-i18n="dailyOffers">Offres du jour</h2></div>
                    <span class="daily-offer-label"><i class="fas fa-sun" aria-hidden="true"></i> <span data-i18n="todayOnly">Aujourd’hui</span></span>
                </div>
                <ul class="product-list daily-offer-list">
                    {{#each dailyOfferItems}}
                    <li class="product-card" data-product-id="{{_id}}">
                        <div class="pc-media"><img src="{{imageUrl}}" alt="{{displayTitle}}" width="112" height="112" loading="lazy"></div>
                        <div class="pc-body"><h3 class="pc-title">{{displayTitle}}</h3>
                            {{#if displayDescription}}<p class="pc-desc">{{displayDescription}}</p>{{/if}}
                            <div class="pc-footer"><span class="pc-price">{{price}} <small>{{@root.currencyLabel}}</small></span>
                                <button type="button" class="add-to-cart-btn" data-name="{{title}}" data-display-name="{{displayTitle}}" data-price="{{price}}" data-img="{{imageUrl}}" aria-label="Ajouter {{displayTitle}} au panier"><i class="fas fa-plus" aria-hidden="true"></i><i class="fas fa-check" aria-hidden="true"></i></button>
                            </div>
                        </div>
                    </li>
                    {{/each}}
                </ul>
            </section>
            {{/if}}

            {{#if homeCategories.length}}
            <ul class="universe-list" id="categoryList" aria-label="Catégories du menu">
                {{#each homeCategories}}
                <li style="--i: {{@index}}" {{#if isExtra}}data-extra-category hidden{{/if}}>
                    <a class="universe-card" href="/UserMenu/categorie/{{slug}}" data-universe-link="{{slug}}">
                        <img class="uc-img" src="{{cover}}" alt="" width="1200" height="640" {{#if @first}}fetchpriority="high"{{else}}loading="lazy"{{/if}} decoding="async">
                        <span class="uc-shade" aria-hidden="true"></span>
                        <span class="uc-icon" aria-hidden="true"><i class="fas {{icon}}"></i></span>
                        <span class="uc-body">
                            <span class="uc-tagline" {{#if i18nKey}}data-i18n="{{i18nKey}}Tag"{{/if}}>{{tagline}}</span>
                            <span class="uc-title" {{#if i18nKey}}data-i18n="{{i18nKey}}"{{/if}}>{{label}}</span>
                            <span class="uc-meta">{{itemCount}} <span data-i18n="products">produits</span>{{#if hasFilters}} · {{subcategoryCount}} <span data-i18n="sections">rubriques</span>{{/if}}</span>
                        </span>
                        <span class="uc-arrow" aria-hidden="true"><i class="fas fa-arrow-right"></i></span>
                    </a>
                </li>
                {{/each}}
            </ul>
            {{#if hasMoreCategories}}
            <button type="button" class="categories-toggle" id="categoriesToggle" aria-expanded="false" aria-controls="categoryList">
                <span data-i18n="showMoreCategories">Afficher la suite</span><i class="fas fa-chevron-down" aria-hidden="true"></i>
            </button>
            {{/if}}
            {{else}}
            <div class="empty-state">
                <span class="empty-icon" aria-hidden="true"><i class="fas fa-utensils"></i></span>
                <p data-i18n="menuSoon">Notre carte arrive très bientôt.</p>
            </div>
            {{/if}}

            <section class="google-reviews-panel" aria-label="Avis Google Maps">
                <div class="google-reviews-copy">
                    <span class="google-review-icon" aria-hidden="true"><i class="fab fa-google"></i></span>
                    <div>
                        <p class="menu-kicker" data-i18n="googleReviews">Avis Google Maps</p>
                        <h2 data-i18n="yourOpinion">Votre avis compte</h2>
                        <p><span data-i18n="shareExperience">Partagez votre expérience chez</span> {{#if restaurantSettings.restaurantName}}{{restaurantSettings.restaurantName}}{{else}}Le Patio Djerba{{/if}}.</p>
                    </div>
                </div>
                <div class="google-review-stars" aria-hidden="true">
                    <i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i>
                </div>
                <div class="google-review-actions">
                    <a href="{{googleReviewsUrl}}" target="_blank" rel="noopener noreferrer" data-i18n="seeReviews">Voir les avis</a>
                    <a href="{{googleReviewsUrl}}" target="_blank" rel="noopener noreferrer" class="is-primary" data-i18n="leaveReview">Laisser un avis</a>
                </div>
            </section>

            <footer class="patio-footer">
                <img src="/images/logo.png" alt="" width="40" height="40">
                <strong>{{#if restaurantSettings.restaurantName}}{{restaurantSettings.restaurantName}}{{else}}Le Patio Djerba{{/if}}</strong>
                {{#if restaurantSettings.address}}<p><i class="fas fa-map-marker-alt" aria-hidden="true"></i> {{restaurantSettings.address}}</p>{{/if}}
                {{#if restaurantSettings.openingHours}}<p><i class="far fa-clock" aria-hidden="true"></i> {{restaurantSettings.openingHours}}</p>{{/if}}
                {{#if restaurantSettings.phone}}<p><i class="fas fa-phone-alt" aria-hidden="true"></i> <a href="tel:{{restaurantSettings.phone}}">{{restaurantSettings.phone}}</a></p>{{/if}}
            </footer>
        </section>

        <!-- ═══════════════════════ VIEWS : one per category universe ═══════════════════════ -->
        {{#each menuUniverses}}
        <section class="view view-category" id="view-{{slug}}" data-view="{{slug}}" data-title="{{label}}" {{#unless isActive}}hidden{{/unless}} aria-labelledby="title-{{slug}}">
            <div class="cat-hero">
                <img class="cat-hero-img" src="{{cover}}" alt="" width="1200" height="640" {{#if isActive}}fetchpriority="high"{{else}}loading="lazy"{{/if}} decoding="async">
                <div class="cat-hero-shade" aria-hidden="true"></div>
                <div class="cat-topbar">
                    <a class="glass-btn" href="/UserMenu" data-nav-back aria-label="Retour aux catégories" data-i18n-aria="backToCategories">
                        <i class="fas fa-arrow-left" aria-hidden="true"></i>
                    </a>
                    <a class="cat-brand" href="/UserMenu" data-nav-back aria-label="Le Patio Djerba — accueil du menu">
                        <span class="brand-logo"><img src="/images/logo.png" alt="" width="38" height="38"></span>
                        <span class="cat-brand-name">Le Patio Djerba</span>
                    </a>
                    <button type="button" class="glass-btn" data-search-open aria-label="Rechercher un produit" data-i18n-aria="search">
                        <i class="fas fa-search" aria-hidden="true"></i>
                    </button>
                </div>
                <div class="cat-hero-text">
                    <span class="cat-icon" aria-hidden="true"><i class="fas {{icon}}"></i></span>
                    <h1 id="title-{{slug}}" {{#if i18nKey}}data-i18n="{{i18nKey}}"{{/if}}>{{label}}</h1>
                    <p {{#if i18nKey}}data-i18n="{{i18nKey}}Desc"{{/if}}>{{description}}</p>
                </div>
            </div>

            <div class="cat-sheet">
                <div class="cat-sticky">
                    <div class="cat-sticky-bar">
                        <a class="mini-back" href="/UserMenu" data-nav-back aria-label="Retour aux catégories" data-i18n-aria="backToCategories">
                            <i class="fas fa-arrow-left" aria-hidden="true"></i>
                        </a>
                        <strong {{#if i18nKey}}data-i18n="{{i18nKey}}"{{/if}}>{{label}}</strong>
                        <span class="cat-count">{{itemCount}} <span data-i18n="products">produits</span></span>
                    </div>
                    {{#if hasFilters}}
                    <div class="filters" role="group" aria-label="Filtrer par rubrique">
                        <button type="button" class="chip is-active" data-filter="all" aria-pressed="true">
                            <span data-i18n="all">Tout</span> <em>{{itemCount}}</em>
                        </button>
                        {{#each subcategories}}
                        <button type="button" class="chip" data-filter="{{filterId}}" aria-pressed="false">
                            {{title}} <em>{{itemCount}}</em>
                        </button>
                        {{/each}}
                    </div>
                    {{/if}}
                </div>

                {{#each subcategories}}
                <section class="sub-section" data-sub="{{filterId}}" aria-label="{{title}}">
                    <h2 class="sub-title{{#unless ../hasFilters}} visually-hidden{{/unless}}"><span>{{title}}</span><em>{{itemCount}}</em></h2>
                    <ul class="product-list">
                        {{#each items}}
                        <li class="product-card{{#unless isAvailable}} is-unavailable{{/unless}}" data-product-id="{{_id}}" data-category="{{../title}}" data-universe="{{../../slug}}">
                            <div class="pc-media">
                                <img src="{{imageUrl}}" alt="{{displayTitle}}" width="112" height="112" loading="lazy" decoding="async">
                                {{#unless isAvailable}}<span class="pc-badge" data-i18n="outOfStock">Épuisé</span>{{/unless}}
                            </div>
                            <div class="pc-body">
                                <h3 class="pc-title">{{displayTitle}}</h3>
                                {{#if servingHours}}<span class="pc-hours"><i class="far fa-clock" aria-hidden="true"></i> {{servingHours}}</span>{{/if}}
                                {{#if displayDescription}}<p class="pc-desc">{{displayDescription}}</p>{{/if}}
                                {{#if size}}<span class="pc-size">{{size}}</span>{{/if}}
                                <div class="pc-footer">
                                    <span class="pc-price">{{price}} <small>{{#if @root.currencyLabel}}{{@root.currencyLabel}}{{else}}DT{{/if}}</small></span>
                                    {{#if isAvailable}}
                                    <button type="button" class="add-to-cart-btn" data-name="{{title}}" data-display-name="{{displayTitle}}" data-price="{{price}}" data-img="{{imageUrl}}" aria-label="Ajouter {{displayTitle}} au panier">
                                        <i class="fas fa-plus" aria-hidden="true"></i><i class="fas fa-check" aria-hidden="true"></i>
                                    </button>
                                    {{else}}
                                    <button type="button" class="add-to-cart-btn" disabled aria-label="{{displayTitle}} épuisé">
                                        <i class="fas fa-ban" aria-hidden="true"></i>
                                    </button>
                                    {{/if}}
                                </div>
                            </div>
                        </li>
                        {{/each}}
                    </ul>
                    {{#unless items.length}}<p class="empty-state" data-i18n="categorySoon">Les produits de cette catégorie arrivent bientôt.</p>{{/unless}}
                </section>
                {{/each}}

                <a class="back-to-categories" href="/UserMenu" data-nav-back>
                    <i class="fas fa-th-large" aria-hidden="true"></i> <span data-i18n="allCategories">Voir toutes les catégories</span>
                </a>
            </div>
        </section>
        {{/each}}

        <!-- ═══════════════════════ VIEW : search ═══════════════════════ -->
        <section class="view view-search" id="view-search" data-view="search" hidden aria-labelledby="searchViewTitle">
            <h1 id="searchViewTitle" class="visually-hidden" data-i18n="search">Rechercher</h1>
            <h2 class="visually-hidden">Résultats de recherche</h2>
            <div class="search-top">
                <a class="mini-back" href="/UserMenu" data-nav-back aria-label="Retour" data-i18n-aria="back">
                    <i class="fas fa-arrow-left" aria-hidden="true"></i>
                </a>
                <label class="search-field">
                    <i class="fas fa-search" aria-hidden="true"></i>
                    <span class="visually-hidden" data-i18n="search">Rechercher</span>
                    <input type="search" id="searchInput" autocomplete="off" enterkeyhint="search" placeholder="Rechercher un plat, une boisson…" data-i18n-placeholder="searchPlaceholder">
                    <button type="button" class="search-clear" id="searchClear" aria-label="Effacer" hidden><i class="fas fa-times-circle" aria-hidden="true"></i></button>
                </label>
            </div>
            <p class="search-hint" id="searchHint" data-i18n="searchHint">Tapez le nom d'un produit, d'un ingrédient ou d'une catégorie.</p>
            <p class="no-results" id="searchEmpty" hidden data-i18n="noResults">Aucun produit ne correspond à votre recherche.</p>
            <ul class="product-list search-results" id="searchResults" aria-live="polite"></ul>
        </section>
    </main>

    <!-- ═══════════════════════ Navigation drawer ═══════════════════════ -->
    <div class="nav-drawer" id="navDrawer" hidden>
        <div class="drawer-backdrop" data-drawer-close></div>
        <aside class="drawer-panel" role="dialog" aria-modal="true" aria-labelledby="drawerTitle">
            <div class="drawer-head">
                <span class="brand-logo"><img src="/images/logo.png" alt="" width="44" height="44"></span>
                <div>
                    <strong id="drawerTitle">{{#if restaurantSettings.restaurantName}}{{restaurantSettings.restaurantName}}{{else}}Le Patio Djerba{{/if}}</strong>
                    <small data-i18n="tagline">Découvrez nos saveurs</small>
                </div>
                <button type="button" class="icon-btn" data-drawer-close aria-label="Fermer le menu" data-i18n-aria="close">
                    <i class="fas fa-times" aria-hidden="true"></i>
                </button>
            </div>

            <nav class="drawer-nav" aria-label="Navigation principale">
                <a href="/UserMenu" data-nav-home data-drawer-link><i class="fas fa-book-open" aria-hidden="true"></i> <span data-i18n="ourMenu">Notre Menu</span></a>
                {{#each homeCategories}}
                <a href="/UserMenu/categorie/{{slug}}" data-universe-link="{{slug}}" data-drawer-link class="is-sub"><i class="fas {{icon}}" aria-hidden="true"></i> <span {{#if i18nKey}}data-i18n="{{i18nKey}}"{{/if}}>{{label}}</span></a>
                {{/each}}
                <button type="button" data-cart-open data-drawer-link><i class="fas fa-shopping-bag" aria-hidden="true"></i> <span data-i18n="myCart">Mon panier</span> <span class="drawer-badge" data-cart-count>0</span></button>
                <button type="button" data-order-status-open data-drawer-link><i class="fas fa-receipt" aria-hidden="true"></i> <span data-i18n="orderStatus">Suivi commande</span></button>
                <button type="button" onclick="openRatingModal()" data-drawer-link><i class="fas fa-star" aria-hidden="true"></i> <span data-i18n="rateExperience">Évaluer votre expérience</span></button>
                <a href="{{googleReviewsUrl}}" target="_blank" rel="noopener noreferrer"><i class="fab fa-google" aria-hidden="true"></i> <span data-i18n="googleReviews">Avis Google Maps</span></a>
            </nav>

            <div class="drawer-settings">
                <label for="langSelect"><i class="fas fa-globe" aria-hidden="true"></i> <span data-i18n="language">Langue</span></label>
                <select id="langSelect" onchange="changeLanguage(this.value)">
                    <option value="fr">Français</option>
                    <option value="ar">العربية</option>
                    <option value="en">English</option>
                </select>
            </div>

            <div class="drawer-account" id="loginButton">
                {{#if menuUser}}
                <span class="account-name"><i class="fas fa-user-circle" aria-hidden="true"></i> {{menuUser.username}}</span>
                <a href="/UserMenu_logout" id="menuLogoutLink" class="btn-outline" data-i18n="logout">Se déconnecter</a>
                {{else}}
                <a href="/UserMenu_loginpage" id="menuLoginLink" class="btn-outline"><i class="fas fa-sign-in-alt" aria-hidden="true"></i> <span data-i18n="login">Se connecter</span></a>
                {{/if}}
            </div>

            <div class="drawer-info">
                {{#if restaurantSettings.address}}<p><i class="fas fa-map-marker-alt" aria-hidden="true"></i> {{restaurantSettings.address}}</p>{{/if}}
                {{#if restaurantSettings.openingHours}}<p><i class="far fa-clock" aria-hidden="true"></i> {{restaurantSettings.openingHours}}</p>{{/if}}
                {{#if restaurantSettings.phone}}<p><i class="fas fa-phone-alt" aria-hidden="true"></i> <a href="tel:{{restaurantSettings.phone}}">{{restaurantSettings.phone}}</a></p>{{/if}}
            </div>
        </aside>
    </div>

    <!-- ═══════════════════════ Cart drawer ═══════════════════════ -->
    <div class="cart-drawer" id="cartDrawer" hidden>
        <div class="drawer-backdrop" data-cart-close></div>
        <aside class="cart-panel dashboard-order" id="dashboard-order" role="dialog" aria-modal="true" aria-labelledby="cartTitle">
            <span class="sheet-grabber" aria-hidden="true"></span>
            <div class="cart-header">
                <h2 id="cartTitle" data-i18n="yourCart">Votre panier</h2>
                <button type="button" class="icon-btn cart-close-icon" data-cart-close aria-label="Fermer le panier" data-i18n-aria="closeCart">
                    <i class="fas fa-times" aria-hidden="true"></i>
                </button>
            </div>
            <img class="cart-venue-photo" src="/images/patio/le-patio-terrasse.jpg" alt="La terrasse du Patio Café & Drinks à Djerba" width="1205" height="1306" loading="lazy">
            <div class="order-address">
                <i class="fas fa-store" aria-hidden="true"></i>
                <div>
                    <p>{{#if restaurantSettings.restaurantName}}{{restaurantSettings.restaurantName}}{{else}}Le Patio Djerba{{/if}}</p>
                    <small>{{#if restaurantSettings.address}}{{restaurantSettings.address}}{{else}}Marina 4180 Houmt Souk Djerba, Tunis{{/if}}</small>
                </div>
            </div>

            <div class="cart-wrapper">
                <div class="order-items-container">
                    <!-- Selected items are rendered here by UserMenu_Cart.js -->
                </div>
            </div>

            <div class="order-total">
                <p><span data-i18n="subtotal">Sous-total</span> <span class="subtotal">0.00 {{#if currencyLabel}}{{currencyLabel}}{{else}}DT{{/if}}</span></p>
                <p class="order-total-grand"><span data-i18n="total">Total</span> <span id="grand-total">0.00 {{#if currencyLabel}}{{currencyLabel}}{{else}}DT{{/if}}</span></p>
            </div>
            <a href="/Order_Details" class="checkout" id="checkoutLink"><span data-i18n="checkout">Valider la commande</span> <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
        </aside>
    </div>

    <!-- ═══════════════════════ Bottom navigation ═══════════════════════ -->
    <nav class="bottom-navigation" aria-label="Navigation rapide">
        <a href="/UserMenu" class="nav-item active" data-nav-home data-bottom-home>
            <i class="fas fa-book-open" aria-hidden="true"></i>
            <span data-i18n="menu">Menu</span>
        </a>
        <button type="button" class="nav-item" data-cart-open aria-controls="cartDrawer" aria-expanded="false">
            <span class="nav-icon-wrap">
                <i class="fas fa-shopping-bag" aria-hidden="true"></i>
                <span class="cart-count-badge is-empty" id="cartCountBadge" data-cart-count aria-live="polite">0</span>
            </span>
            <span data-i18n="cart">Panier</span>
        </button>
        <button type="button" id="navOrderStatusBtn" class="nav-item">
            <i class="fas fa-receipt" aria-hidden="true"></i>
            <span data-i18n="orders">Commandes</span>
        </button>
        <a href="{{googleReviewsUrl}}" target="_blank" rel="noopener noreferrer" class="nav-item">
            <i class="fas fa-star" aria-hidden="true"></i>
            <span data-i18n="reviews">Avis</span>
        </a>
    </nav>

    <div class="cart-toast" id="cartToast" role="status" hidden>
        <i class="fas fa-check-circle" aria-hidden="true"></i>
        <span id="cartToastText"></span>
        <button type="button" data-cart-open class="cart-toast-link" data-i18n="view">Voir</button>
    </div>

    <div class="ready-order-toast" id="readyOrderToast" role="alert" hidden>
        <button type="button" class="ready-toast-close" id="readyOrderToastClose" aria-label="Masquer la notification">
            <i class="fas fa-times" aria-hidden="true"></i>
        </button>
        <strong>Commande prête</strong>
        <span id="readyOrderToastText">Votre article est prêt.</span>
    </div>

    <!-- Modal Rating -->
    <div id="ratingModal" class="rating-modal" hidden>
        <div class="rating-backdrop" onclick="closeRatingModal()"></div>
        <div class="rating-panel" role="dialog" aria-modal="true" aria-labelledby="ratingTitle">
            <div class="rating-head">
                <h3 id="ratingTitle"><i class="fas fa-star" aria-hidden="true"></i> <span data-i18n="yourOpinion">Votre avis compte</span></h3>
                <button type="button" class="icon-btn" onclick="closeRatingModal()" aria-label="Fermer">&times;</button>
            </div>
            <p class="rating-intro">Donnez-nous une note pour votre repas chez Le Patio Djerba :</p>
            <div id="starRating" class="star-rating" role="radiogroup" aria-label="Note sur 5">
                <i class="fas fa-star" role="radio" aria-label="1 étoile" tabindex="0"></i>
                <i class="fas fa-star" role="radio" aria-label="2 étoiles" tabindex="0"></i>
                <i class="fas fa-star" role="radio" aria-label="3 étoiles" tabindex="0"></i>
                <i class="fas fa-star" role="radio" aria-label="4 étoiles" tabindex="0"></i>
                <i class="fas fa-star" role="radio" aria-label="5 étoiles" tabindex="0"></i>
            </div>
            <label class="visually-hidden" for="ratingFeedback">Commentaire</label>
            <textarea id="ratingFeedback" placeholder="Un commentaire ou une suggestion ? (Optionnel)" rows="3"></textarea>
            <button type="button" class="btn-primary" onclick="submitOrderRating()">Envoyer mon avis</button>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const tableStorageKey = 'kaffaSelectedTableNumber';
            const tableLockedStorageKey = 'kaffaSelectedTableLocked';
            const params = new URLSearchParams(window.location.search);
            const tableContext = document.getElementById('tableContext');
            const tableContextKicker = document.getElementById('tableContextKicker');
            const tableContextLabel = document.getElementById('tableContextLabel');
            const tableSelectorWrap = document.getElementById('tableSelectorWrap');
            const tableSelect = document.getElementById('userMenuTableSelect');
            const checkoutLink = document.getElementById('checkoutLink');
            const loginLink = document.getElementById('menuLoginLink');
            const logoutLink = document.getElementById('menuLogoutLink');
            const orderStatusPanel = document.getElementById('clientOrderStatus');
            const navOrderStatusBtn = document.getElementById('navOrderStatusBtn');
            const orderStatusList = document.getElementById('clientOrderStatusList');
            const orderStatusCount = document.getElementById('clientOrderStatusCount');
            const orderStatusClose = document.getElementById('clientOrderStatusClose');
            const readyOrderToast = document.getElementById('readyOrderToast');
            const readyOrderToastText = document.getElementById('readyOrderToastText');
            const readyOrderToastClose = document.getElementById('readyOrderToastClose');
            const lastOrderStorageKey = 'kaffaLastOrderId';
            const notifiedReadyStorageKey = 'kaffaReadyNotifiedItems';
            let orderStatusDismissed = false;
            let lastOrderStatusKeys = '';
            let readyToastTimer = null;
            let hasOrderItems = false;

            // Login / logout links always return to the current menu view.
            function updateAuthLinks() {
                const currentReturnTo = `${window.location.pathname}${window.location.search}`;
                if (loginLink) loginLink.href = `/UserMenu_loginpage?returnTo=${encodeURIComponent(currentReturnTo)}`;
                if (logoutLink) logoutLink.href = `/UserMenu_logout?returnTo=${encodeURIComponent(currentReturnTo)}`;
            }
            updateAuthLinks();
            document.addEventListener('patio:viewchange', updateAuthLinks);

            function showOrderStatusPanel() {
                orderStatusDismissed = false;
                const reveal = () => {
                    orderStatusPanel.hidden = false;
                    if (!hasOrderItems) {
                        orderStatusCount.textContent = '0 article';
                        orderStatusList.innerHTML = '<p class="order-status-empty">Aucune commande en cours pour le moment.</p>';
                    }
                    orderStatusPanel.scrollIntoView({ behavior: 'smooth', block: 'center' });
                };
                if (window.patioRouter && window.patioRouter.current() !== 'home') {
                    window.patioRouter.show('home');
                    setTimeout(reveal, 380);
                } else {
                    reveal();
                }
            }
            if (navOrderStatusBtn) navOrderStatusBtn.addEventListener('click', showOrderStatusPanel);
            document.querySelectorAll('[data-order-status-open]').forEach((btn) => btn.addEventListener('click', showOrderStatusPanel));

            function normalizeTableNumber(value) {
                const tableNumber = Number(value);
                return Number.isInteger(tableNumber) && tableNumber > 0 ? String(tableNumber) : '';
            }

            const urlTable = normalizeTableNumber(params.get('table'));
            const isCounterMode = params.get('mode') === 'counter';

            if (urlTable) {
                localStorage.setItem(tableStorageKey, urlTable);
                localStorage.setItem(tableLockedStorageKey, 'true');
            } else if (isCounterMode) {
                localStorage.removeItem(tableStorageKey);
                localStorage.setItem(tableLockedStorageKey, 'false');
            }

            function getSelectedTable() {
                return normalizeTableNumber(localStorage.getItem(tableStorageKey));
            }

            function isTableLocked() {
                return localStorage.getItem(tableLockedStorageKey) === 'true' && Boolean(getSelectedTable());
            }

            function updateCheckoutLink() {
                const selectedTable = getSelectedTable();
                const url = new URL('/Order_Details', window.location.origin);

                if (selectedTable) {
                    url.searchParams.set('table', selectedTable);
                } else if (isCounterMode) {
                    url.searchParams.set('mode', 'counter');
                }

                checkoutLink.href = `${url.pathname}${url.search}`;
            }

            function renderTableContext() {
                const selectedTable = getSelectedTable();
                const locked = isTableLocked();

                // Hide table prompt completely if table is already selected or scanned via QR code
                tableContext.hidden = Boolean(locked || selectedTable);
                tableContext.classList.toggle('is-locked', locked);
                tableSelectorWrap.hidden = locked;

                if (selectedTable) {
                    tableSelect.value = selectedTable;
                    tableContextKicker.textContent = locked ? 'Table QR scannée' : 'Commande sur place';
                    tableContextLabel.textContent = `Table ${selectedTable}`;
                } else {
                    tableSelect.value = '';
                    tableContextKicker.textContent = 'Commande sur place';
                    tableContextLabel.textContent = 'Choisissez votre table';
                }

                updateCheckoutLink();
            }

            tableSelect.addEventListener('change', () => {
                const selectedTable = normalizeTableNumber(tableSelect.value);

                if (selectedTable) {
                    localStorage.setItem(tableStorageKey, selectedTable);
                    localStorage.setItem(tableLockedStorageKey, 'false');
                } else {
                    localStorage.removeItem(tableStorageKey);
                    localStorage.setItem(tableLockedStorageKey, 'false');
                }

                renderTableContext();
            });

            renderTableContext();

            function getNotifiedReadyItems() {
                try {
                    return JSON.parse(localStorage.getItem(notifiedReadyStorageKey) || '[]');
                } catch (error) {
                    return [];
                }
            }

            function saveNotifiedReadyItems(items) {
                localStorage.setItem(notifiedReadyStorageKey, JSON.stringify(items.slice(-80)));
            }

            function showReadyToast(item) {
                readyOrderToastText.textContent = `${item.itemName} est PRÊT. Venez récupérer votre commande.`;
                readyOrderToast.hidden = false;
                readyOrderToast.classList.add('is-visible');
                if (readyToastTimer) {
                    clearTimeout(readyToastTimer);
                }
                readyToastTimer = setTimeout(hideReadyToast, 6500);
            }

            function hideReadyToast() {
                if (readyToastTimer) {
                    clearTimeout(readyToastTimer);
                    readyToastTimer = null;
                }
                readyOrderToast.classList.remove('is-visible');
                readyOrderToast.hidden = true;
            }

            function escapeHtml(value) {
                return String(value || '')
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#039;');
            }

            let clientAudioCtx = null;
            function getClientAudioContext() {
                if (!clientAudioCtx) {
                    const AudioCtx = window.AudioContext || window.webkitAudioContext;
                    if (AudioCtx) clientAudioCtx = new AudioCtx();
                }
                if (clientAudioCtx && clientAudioCtx.state === 'suspended') {
                    try { clientAudioCtx.resume(); } catch(e) {}
                }
                return clientAudioCtx;
            }

            ['click', 'touchstart', 'pointerdown', 'keydown'].forEach(evt => {
                window.addEventListener(evt, () => { getClientAudioContext(); }, { passive: true, once: true });
            });

            if ("Notification" in window && Notification.permission === "default") {
                try { Notification.requestPermission(); } catch(e) {}
            }

            function playStatusChangeChime() {
                try {
                    const ctx = getClientAudioContext();
                    if (ctx) {
                        const now = ctx.currentTime;

                        const osc1 = ctx.createOscillator();
                        const osc2 = ctx.createOscillator();
                        const osc3 = ctx.createOscillator();
                        const gain = ctx.createGain();

                        osc1.type = 'sine';
                        osc2.type = 'sine';
                        osc3.type = 'sine';

                        osc1.frequency.setValueAtTime(523.25, now);        // C5
                        osc2.frequency.setValueAtTime(659.25, now + 0.15);  // E5
                        osc3.frequency.setValueAtTime(783.99, now + 0.30);  // G5

                        gain.gain.setValueAtTime(0.7, now);
                        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.8);

                        osc1.connect(gain);
                        osc2.connect(gain);
                        osc3.connect(gain);
                        gain.connect(ctx.destination);

                        osc1.start(now);
                        osc1.stop(now + 0.20);
                        osc2.start(now + 0.15);
                        osc2.stop(now + 0.35);
                        osc3.start(now + 0.30);
                        osc3.stop(now + 0.80);
                    }
                } catch(e) {}

                if ("vibrate" in navigator) {
                    try { navigator.vibrate([200, 100, 200]); } catch(e) {}
                }
            }

            const STATUS_LABELS_MAP = {
                pending: '🟡 En attente',
                en_cours: '🔵 En préparation',
                pret: '🟢 Prêt ! Venez récupérer',
                cancel: '🔴 Annulée'
            };

            const clientItemStatuses = new Map();

            function checkItemStatusChanges(allItems) {
                allItems.forEach(item => {
                    const key = `${item.orderId || ''}-${item.itemIndex}`;
                    const prevStatus = clientItemStatuses.get(key);
                    const currentStatus = item.status;

                    if (prevStatus !== undefined && prevStatus !== currentStatus) {
                        playStatusChangeChime();

                        const statusText = STATUS_LABELS_MAP[currentStatus] || currentStatus;
                        const title = `🔔 Le Patio Djerba`;
                        const body = `${item.itemName} ➔ ${statusText}`;

                        if ("Notification" in window && Notification.permission === "granted") {
                            try {
                                new Notification(title, {
                                    body: body,
                                    icon: "/images/logo.png",
                                    vibrate: [200, 100, 200]
                                });
                            } catch(e) {}
                        }
                    }
                    clientItemStatuses.set(key, currentStatus);
                });
            }

            function renderOrderStatus(data) {
                const allItems = data.orders.flatMap((order) => order.items.map((item) => ({
                    ...item,
                    orderId: order.orderId,
                    orderIdDisplay: order.orderIdDisplay,
                    serviceTypeLabel: order.serviceTypeLabel,
                    tableDisplay: order.tableDisplay,
                })));

                if (allItems.length === 0) {
                    hasOrderItems = false;
                    orderStatusDismissed = false;
                    lastOrderStatusKeys = '';
                    orderStatusPanel.hidden = true;
                    return;
                }

                hasOrderItems = true;
                checkItemStatusChanges(allItems);

                // Re-open the panel after a manual close only when a status changed.
                const statusKeys = allItems.map((item) => `${item.orderId}-${item.itemIndex}-${item.status}`).join('|');
                if (orderStatusDismissed && statusKeys === lastOrderStatusKeys) {
                    return;
                }
                orderStatusDismissed = false;
                lastOrderStatusKeys = statusKeys;

                orderStatusPanel.hidden = false;
                orderStatusCount.textContent = `${allItems.length} ${allItems.length === 1 ? 'article' : 'articles'}`;
                orderStatusList.innerHTML = allItems.map((item) => `
                    <div class="client-order-status-row">
                        <div class="order-row-name">
                            <span class="order-row-id">#${escapeHtml(item.orderIdDisplay)}</span>
                            <strong>${escapeHtml(item.itemName)}</strong>
                        </div>
                        <em class="status-badge status-${escapeHtml(item.status || 'pending')}">
                            ${escapeHtml(STATUS_LABELS_MAP[item.status] || item.statusLabel)}
                        </em>
                    </div>
                `).join('');

                const notifiedReadyItems = getNotifiedReadyItems();
                const nextNotifiedReadyItems = [...notifiedReadyItems];
                data.readyItems.forEach((item) => {
                    if (!notifiedReadyItems.includes(item.readyKey)) {
                        showReadyToast(item);
                        nextNotifiedReadyItems.push(item.readyKey);
                    }
                });
                saveNotifiedReadyItems(nextNotifiedReadyItems);
            }

            async function refreshOrderStatus() {
                try {
                    const lastOrderId = localStorage.getItem(lastOrderStorageKey);
                    const url = new URL('/UserMenu/order-status', window.location.origin);
                    if (lastOrderId) {
                        url.searchParams.set('orderId', lastOrderId);
                    }

                    const response = await fetch(`${url.pathname}${url.search}`, {
                        headers: { 'Accept': 'application/json' },
                    });
                    const data = await response.json();

                    if (response.ok && data.success) {
                        renderOrderStatus(data);
                    }
                } catch (error) {
                    console.error('Error refreshing order status:', error);
                }
            }

            refreshOrderStatus();
            setInterval(refreshOrderStatus, 3000);

            orderStatusClose.addEventListener('click', () => {
                orderStatusDismissed = true;
                orderStatusPanel.hidden = true;
            });

            readyOrderToastClose.addEventListener('click', hideReadyToast);
        });

        // ── ⭐ Rating modal ──────────────────────────────────────────────
        let currentSelectedRating = 5;

        function openRatingModal() {
            const modal = document.getElementById('ratingModal');
            if (!modal) return;
            if (window.patioDrawer) window.patioDrawer.close(false);
            modal.hidden = false;
            selectRating(currentSelectedRating);
            const firstStar = modal.querySelector('#starRating i');
            if (firstStar) setTimeout(() => firstStar.focus(), 50);
        }

        function closeRatingModal() {
            const modal = document.getElementById('ratingModal');
            if (modal) modal.hidden = true;
        }

        function selectRating(stars) {
            currentSelectedRating = stars;
            document.querySelectorAll('#starRating i').forEach((star, idx) => {
                star.classList.toggle('is-on', idx < stars);
                star.setAttribute('aria-checked', String(idx + 1 === stars));
            });
        }

        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('#starRating i').forEach((star, idx) => {
                star.addEventListener('click', () => selectRating(idx + 1));
                star.addEventListener('keydown', (event) => {
                    if (event.key === 'Enter' || event.key === ' ') {
                        event.preventDefault();
                        selectRating(idx + 1);
                    }
                });
            });
            document.addEventListener('keydown', (event) => {
                const modal = document.getElementById('ratingModal');
                if (event.key === 'Escape' && modal && !modal.hidden) closeRatingModal();
            });
        });

        async function submitOrderRating() {
            const lastOrderId = localStorage.getItem('kaffaLastOrderId');
            const feedback = document.getElementById('ratingFeedback')?.value || '';

            if (!lastOrderId) {
                alert('Aucune commande récente à évaluer.');
                closeRatingModal();
                return;
            }

            try {
                const res = await fetch(`/api/orders/${lastOrderId}/rating`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ rating: currentSelectedRating, feedback })
                });
                const data = await res.json();
                if (data.success) {
                    alert('Merci infiniment pour votre avis ! ⭐');
                    closeRatingModal();
                } else {
                    alert(data.error || 'Erreur lors de l\'envoi.');
                }
            } catch(e) {
                alert('Impossible d\'envoyer l\'avis.');
            }
        }
    </script>

    <script src="/javascript/patio-menu.js"></script>
    <script src="/javascript/UserMenu_Cart.js"></script>
</body>

</html>
