<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Le Patio Djerba — Créer un compte</title>
    <meta name="description" content="Créez votre compte administrateur pour gérer le restaurant Le Patio Djerba.">
    <meta name="robots" content="noindex, nofollow">
    <link rel="stylesheet" type="text/css" href="/css/style.css">
    <script src="https://kit.fontawesome.com/ce75bd9e29.js" crossorigin="anonymous"></script>
</head>
<body>
    <div class="container">
        <!-- Left decorative panel -->
        <div class="side">
            <img src="/images/side.jpg" alt="Le Patio Djerba">
            <div class="side-tagline">
                <h2>Le Patio Djerba</h2>
                <p>Espace Administrateur</p>
            </div>
        </div>

        <!-- Right form panel -->
        <div class="form-box">
            <span class="form-badge">
                <i class="fa fa-user-plus"></i>
                Nouveau compte
            </span>
            <h1>Créer un compte</h1>
            <p class="form-subtitle">Remplissez les informations pour commencer</p>

            {{#if errorMessage}}
            <div class="error-message">
                <i class="fa fa-exclamation-circle"></i>
                {{errorMessage}}
            </div>
            {{/if}}

            <form action="/index" method="POST" style="width:100%">
                <div class="input-group">
                    <div class="input-field" id="namefield">
                        <i class="fa fa-cutlery"></i>
                        <input type="text" placeholder="Nom du restaurant" name="name" autocomplete="organization">
                    </div>
                    <div class="input-field">
                        <i class="fa fa-envelope-o"></i>
                        <input type="email" placeholder="Adresse e-mail" name="email" required autocomplete="email">
                    </div>
                    <div class="input-field">
                        <i class="fa fa-lock"></i>
                        <input type="password" placeholder="Mot de passe" name="password" required autocomplete="new-password">
                    </div>
                </div>
                <div class="btn-field">
                    <button type="submit" id="signupBtn">
                        Créer mon compte &nbsp;<i class="fa fa-arrow-right"></i>
                    </button>
                </div>
                <div>
                    <span>Déjà un compte ? <a href="/">Se connecter</a></span>
                </div>
            </form>
        </div>
    </div>
</body>
</html>