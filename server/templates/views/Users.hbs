<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Utilisateurs Client | Le Patio</title>
    <link rel="stylesheet" href="/css/admin-theme.css">
    <link rel="stylesheet" href="/css/categories.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
</head>

<body>
    <div class="main">
        <div class="bigBox">
            {{>Sidebar}}
            
            <main class="boxes fade-in">
                <section class="upperbox">
                    <div class="upperbox-text">
                        <p class="eyebrow">Clientèle</p>
                        <h1>Comptes Clients</h1>
                    </div>
                </section>

                <section class="lowerbox">
                    <div class="list-heading">
                        <div>
                            <p class="eyebrow">Utilisateurs inscrits</p>
                            <h2>Liste des clients</h2>
                        </div>
                        <span id="userCountLabel">{{userCount}} clients</span>
                    </div>

                    <div class="lowerbox-table" aria-label="Table des utilisateurs">
                        {{#if hasUsers}}
                        <table>
                            <thead>
                                <tr>
                                    <th>Nom / Identifiant</th>
                                    <th>Téléphone</th>
                                    <th>Email</th>
                                    <th style="text-align: center;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {{#each users}}
                                <tr data-id="{{this._id}}" id="user-{{this._id}}">
                                    <td class="name-cell" data-label="Nom">
                                        <span class="cell-text strong-text">{{this.username}}</span>
                                    </td>
                                    <td data-label="Téléphone">
                                        <span class="cell-text" style="color: #64748B;">{{this.phonenumber}}</span>
                                    </td>
                                    <td data-label="Email">
                                        <span class="cell-text" style="color: #64748B;">{{this.email}}</span>
                                    </td>
                                    <td class="action-cell" data-label="Actions" style="text-align: center;">
                                        <button class="icon-action delete-action" type="button" onclick="confirmDeleteUser('{{this._id}}')" aria-label="Supprimer {{this.username}}">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                                {{/each}}
                            </tbody>
                        </table>
                        {{else}}
                        <div class="empty-state">
                            <i class="fa-solid fa-users"></i>
                            <p>Aucun utilisateur inscrit pour le moment.</p>
                        </div>
                        {{/if}}
                    </div>
                </section>

                <div id="successPopup" class="popup">
                    <div class="popup_content">
                        <p><i class="fa-solid fa-circle-check"></i> Compte supprimé avec succès !</p>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <script src="/javascript/index.js"></script>
    <script>
        function confirmDeleteUser(id) {
            if (confirm('Voulez-vous vraiment supprimer ce compte client ?')) {
                deleteUser(id);
            }
        }

        function updateUserCount() {
            const countLabel = document.getElementById('userCountLabel');
            const count = document.querySelectorAll('.lowerbox-table tbody tr').length;

            if (countLabel) {
                countLabel.textContent = `${count} ${count === 1 ? 'client' : 'clients'}`;
            }
        }

        async function deleteUser(id) {
            try {
                const response = await fetch(`/Users/${encodeURIComponent(id)}`, {
                    method: 'DELETE',
                    headers: { 'Accept': 'application/json' },
                });

                const data = await response.json();
                if (!response.ok || !data.success) {
                    throw new Error('Request failed');
                }

                const row = document.querySelector(`tr[data-id="${id}"]`);
                if (row) {
                    row.remove();
                    updateUserCount();
                    $('#successPopup').fadeIn();
                }

                setTimeout(function () {
                    $('#successPopup').fadeOut();
                }, 3000);
            } catch (error) {
                alert('Impossible de supprimer le compte.');
            }
        }

        $(document).ready(function () {
            $(window).click(function () {
                $('#successPopup').fadeOut();
            });
        });
    </script>
</body>

</html>
