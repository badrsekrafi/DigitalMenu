<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Le Patio Djerba — Admin Login</title>
    <meta name="description" content="Connectez-vous à l'espace administrateur du restaurant Le Patio Djerba.">
    <meta name="robots" content="noindex, nofollow">
    <link rel="stylesheet" type="text/css" href="/css/loginpage.css">
    <script src="https://kit.fontawesome.com/ce75bd9e29.js" crossorigin="anonymous"></script>
</head>
<body>
    <div class="container">
        <!-- Left decorative panel -->
        <div class="side">
            <img src="/images/side.jpg" alt="Le Patio Djerba">
            <div class="side-tagline">
                <h2>Le Patio Djerba</h2>
                <p>Espace Administrateur</p>
            </div>
        </div>

        <!-- Right form panel -->
        <div class="form-box">
            <span class="form-badge">
                <i class="fa fa-lock"></i>
                Accès sécurisé
            </span>
            <h1>Bienvenue</h1>
            <p class="form-subtitle">Connectez-vous pour gérer votre restaurant</p>

            {{#if errorMessage}}
            <div class="error-message">
                <i class="fa fa-exclamation-circle"></i>
                {{errorMessage}}
            </div>
            {{/if}}

            <form action="/login" method="POST" style="width:100%">
                <div class="input-field">
                    <i class="fa fa-envelope-o"></i>
                    <input type="email" placeholder="Adresse e-mail" name="email" required autocomplete="email">
                </div>
                <div class="input-field">
                    <i class="fa fa-lock"></i>
                    <input type="password" placeholder="Mot de passe" name="password" required autocomplete="current-password">
                </div>
                <div class="btn-field">
                    <button type="submit" id="signinBtn">
                        Se connecter &nbsp;<i class="fa fa-arrow-right"></i>
                    </button>
                </div>
                <div style="text-align:center;margin-top:14px;font-size:12px;color:#94A3B8;display:flex;align-items:center;justify-content:center;gap:6px;">
                    <i class="fa fa-shield"></i> Accès réservé uniquement à l'administrateur
                </div>
            </form>
        </div>
    </div>
</body>
</html>