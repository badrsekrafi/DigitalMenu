<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Le Patio Djerba — Admin Login</title>
    <meta name="description" content="Connectez-vous à l'espace administrateur du restaurant Le Patio Djerba.">
    <meta name="robots" content="noindex, nofollow">
    <link rel="stylesheet" type="text/css" href="/css/loginpage.css">
    <script src="https://kit.fontawesome.com/ce75bd9e29.js" crossorigin="anonymous"></script>
</head>
<body>
    <div class="container">
        <div class="side">
            <img src="/images/side.jpg" alt="error">
        </div>
        <div class="form-box">
            <h1 id="title">Sign In</h1>
            <form action="/login" method="POST">
                <div class="input-field">
                    <i class="fa fa-envelope-o"></i>
                    <input type="email" placeholder="Email" name="email" required>
                </div>
                <div class="input-field">
                    <i class="fa fa-lock"></i>
                    <input type="password" placeholder="Password" name="password" required>
                </div>

                <div class="btn-field">
                    <button type="submit" id="signinBtn" value="signin">Sign in</button>
                </div>
                <div>
                    <span>Don't have an Account? <a href="/index">Sign Up</a></span>
                </div>
            </form>
        </div>
    </div>
</body>
</html>