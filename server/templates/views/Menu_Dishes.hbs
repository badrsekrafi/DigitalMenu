<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Plats du Menu | Dine/Delight</title>
    <link rel="stylesheet" href="/css/admin-theme.css">
    <link rel="stylesheet" href="/css/Menu_Dishes.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
</head>

<body>
    <div class="main">
        <div class="bigBox">
            {{>Sidebar}}

            <main class="boxes fade-in">
                <section class="upperbox">
                    <div class="upperbox-text">
                        <p class="eyebrow">Inventaire</p>
                        <h1>Plats du Menu</h1>
                    </div>
                    <a class="upperbox-btn" href="/Menu_Dishes_add">
                        <i class="fa-solid fa-plus"></i>
                        <span>Ajouter un plat</span>
                    </a>
                </section>

                <section class="lowerbox">
                    <div class="list-heading">
                        <div>
                            <p class="eyebrow">Produits</p>
                            <h2>Liste des plats</h2>
                        </div>
                        <span id="menuItemCount">{{itemCount}} plats</span>
                    </div>

                    <div class="lowerbox-table" aria-label="Table des plats">
                        {{#if hasMenuItems}}
                        <table>
                            <thead>
                                <tr>
                                    <th>Nom</th>
                                    <th>Description</th>
                                    <th>Prix</th>
                                    <th>Taille</th>
                                    <th>Catégorie</th>
                                    <th>Image</th>
                                    <th>Disponibilité</th>
                                    <th style="text-align: center;">Modifier</th>
                                    <th style="text-align: center;">Supprimer</th>
                                </tr>
                            </thead>
                            <tbody>
                                {{#each MenuItems}}
                                <tr data-id="{{this._id}}" id="Menu_Dishes-{{this._id}}">
                                    <td class="name-cell" data-label="Nom">
                                        <span class="cell-text strong-text">{{this.title}}</span>
                                    </td>
                                    <td class="description-cell" data-label="Description">
                                        <span class="cell-text" style="color: #64748B;">{{this.description}}</span>
                                    </td>
                                    <td class="price-cell" data-label="Prix">
                                        <span class="price-pill">{{this.price}} DNT</span>
                                    </td>
                                    <td class="size-cell" data-label="Taille">
                                        <span class="cell-text" style="color: #64748B;">{{#if this.size}}{{this.size}}{{else}}-{{/if}}</span>
                                    </td>
                                    <td class="category-cell" data-label="Catégorie">
                                        <span class="category-pill">{{#if this.category}}{{this.category}}{{else}}Sans catégorie{{/if}}</span>
                                    </td>
                                    <td class="image-cell" data-label="Image">
                                        <img src="{{this.imageUrl}}" alt="{{this.title}}" loading="lazy" onerror="this.src='/images/Admin_image.png'">
                                    </td>
                                    <td data-label="Disponibilité" style="text-align: center;">
                                        <button type="button" onclick="toggleItemStock('{{this._id}}', this)" style="padding:5px 12px;border-radius:20px;font-size:11px;font-weight:700;border:none;cursor:pointer;{{#if this.isAvailable}}background:#DCFCE7;color:#15803D;{{else}}background:#FEE2E2;color:#B91C1C;{{/if}}">
                                            {{#if this.isAvailable}}En Stock{{else}}Épuisé{{/if}}
                                        </button>
                                    </td>
                                    <td class="edit_column action-cell" data-label="Modifier" style="text-align: center;">
                                        <a class="icon-action edit-action" href="/Menu_Dishes_add?id={{this._id}}" aria-label="Modifier {{this.title}}">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                        </a>
                                    </td>
                                    <td class="delete_column action-cell" data-label="Supprimer" style="text-align: center;">
                                        <button class="icon-action delete-action" type="button" onclick="confirmDelete('{{this._id}}')" aria-label="Supprimer {{this.title}}">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                                {{/each}}
                            </tbody>
                        </table>
                        {{else}}
                        <div class="empty-state">
                            <i class="fa-solid fa-utensils"></i>
                            <p>Aucun plat pour le moment.</p>
                        </div>
                        {{/if}}
                    </div>
                </section>

                <div id="successPopup" class="popup">
                    <div class="popup_content">
                        <p><i class="fa-solid fa-circle-check"></i> Plat supprimé avec succès !</p>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <script src="/javascript/index.js"></script>
    <script>
        function confirmDelete(id) {
            if (confirm('Voulez-vous vraiment supprimer ce plat ?')) {
                deleteItem(id);
            }
        }

        function updateItemCount() {
            const countLabel = document.getElementById('menuItemCount');
            const count = document.querySelectorAll('.lowerbox-table tbody tr').length;

            if (countLabel) {
                countLabel.textContent = `${count} ${count === 1 ? 'plat' : 'plats'}`;
            }
        }

        async function deleteItem(id) {
            try {
                const response = await fetch(`/deleteMenuItem/${encodeURIComponent(id)}`, {
                    method: 'DELETE',
                    headers: { 'Accept': 'application/json' },
                });

                if (!response.ok) {
                    throw new Error('Request failed');
                }

                const rowToDelete = document.querySelector(`#Menu_Dishes-${id}`);
                if (rowToDelete) {
                    rowToDelete.remove();
                    updateItemCount();
                    $('#successPopup').fadeIn();
                    setTimeout(function () {
                        $('#successPopup').fadeOut();
                    }, 3000);
                }
            } catch (error) {
                alert('Impossible de supprimer le plat.');
            }
        }

        async function toggleItemStock(id, btn) {
            btn.disabled = true;
            try {
                const res = await fetch(`/api/menu-items/${id}/toggle-stock`, { method: 'PATCH' });
                const data = await res.json();
                if (data.success) {
                    if (data.isAvailable) {
                        btn.textContent = 'En Stock';
                        btn.style.background = '#DCFCE7';
                        btn.style.color = '#15803D';
                    } else {
                        btn.textContent = 'Épuisé';
                        btn.style.background = '#FEE2E2';
                        btn.style.color = '#B91C1C';
                    }
                }
            } catch(e) {
                alert('Erreur lors du changement de stock.');
            } finally {
                btn.disabled = false;
            }
        }

        $(document).ready(function () {
            $(window).click(function () {
                $('#successPopup').fadeOut();
            });
        });
    </script>
</body>

</html>
