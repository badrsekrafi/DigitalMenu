<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Catégories | Le Patio</title>
    <link rel="stylesheet" href="/css/admin-theme.css">
    <link rel="stylesheet" href="/css/categories.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
</head>

<body>
    <div class="main">
        <div class="bigBox">
            {{>Sidebar}}
            
            <main class="boxes fade-in">
                <section class="upperbox">
                    <div class="upperbox-text">
                        <p class="eyebrow">Inventaire</p>
                        <h1>Catégories</h1>
                    </div>
                    <a class="upperbox-btn" href="/Categories_add">
                        <i class="fa-solid fa-plus"></i>
                        <span>Ajouter une catégorie</span>
                    </a>
                </section>

                <section class="lowerbox">
                    <div class="list-heading">
                        <div>
                            <p class="eyebrow">Groupes</p>
                            <h2>Liste des catégories</h2>
                        </div>
                        <span id="categoryCountLabel">{{categoryCount}} catégories</span>
                    </div>

                    <div class="lowerbox-table" aria-label="Table des catégories">
                        {{#if hasCategories}}
                        <table>
                            <thead>
                                <tr>
                                    <th>Nom</th>
                                    <th>Description</th>
                                    <th style="text-align: center;">Modifier</th>
                                    <th style="text-align: center;">Supprimer</th>
                                </tr>
                            </thead>
                            <tbody>
                                {{#each categories}}
                                <tr data-id="{{this._id}}" id="category-{{this._id}}">
                                    <td class="name-cell" data-label="Nom">
                                        <span class="cell-text strong-text">{{this.title}}</span>
                                    </td>
                                    <td class="description-cell" data-label="Description">
                                        <span class="cell-text" style="color: #64748B;">{{this.description}}</span>
                                    </td>
                                    <td class="action-cell" data-label="Modifier" style="text-align: center;">
                                        <a class="icon-action edit-action" href="/Categories_add?id={{this._id}}" aria-label="Modifier {{this.title}}">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                        </a>
                                    </td>
                                    <td class="action-cell" data-label="Supprimer" style="text-align: center;">
                                        <button class="icon-action delete-action" type="button" onclick="confirmDelete('{{this._id}}')" aria-label="Supprimer {{this.title}}">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                                {{/each}}
                            </tbody>
                        </table>
                        {{else}}
                        <div class="empty-state">
                            <i class="fa-solid fa-layer-group"></i>
                            <p>Aucune catégorie pour le moment.</p>
                        </div>
                        {{/if}}
                    </div>
                </section>

                <div id="successPopup" class="popup">
                    <div class="popup_content">
                        <p><i class="fa-solid fa-circle-check"></i> Catégorie supprimée avec succès !</p>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <script src="/javascript/index.js"></script>
    <script>
        function confirmDelete(id) {
            if (confirm('Voulez-vous vraiment supprimer cette catégorie ?')) {
                deleteCategory(id);
            }
        }

        function updateCategoryCount() {
            const countLabel = document.getElementById('categoryCountLabel');
            const count = document.querySelectorAll('.lowerbox-table tbody tr').length;

            if (countLabel) {
                countLabel.textContent = `${count} ${count === 1 ? 'catégorie' : 'catégories'}`;
            }
        }

        async function deleteCategory(id) {
            try {
                const response = await fetch(`/deleteCategory/${encodeURIComponent(id)}`, {
                    method: 'DELETE',
                    headers: { 'Accept': 'application/json' },
                });

                const data = await response.json();
                if (!response.ok || !data.success) {
                    throw new Error('Request failed');
                }

                const row = document.querySelector(`tr[data-id="${id}"]`);
                if (row) {
                    row.remove();
                    updateCategoryCount();
                    $('#successPopup').fadeIn();
                }

                setTimeout(function () {
                    $('#successPopup').fadeOut();
                }, 3000);
            } catch (error) {
                alert('Impossible de supprimer la catégorie.');
            }
        }

        $(document).ready(function () {
            $(window).click(function () {
                $('#successPopup').fadeOut();
            });
        });
    </script>
</body>

</html>
