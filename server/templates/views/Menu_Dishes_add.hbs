<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nouvel Article | Dine/Delight</title>
    <link rel="stylesheet" href="/css/admin-theme.css">
    <link rel="stylesheet" href="/css/form-page.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
</head>
<body>
    <div class="main">
        <div class="bigBox">
            {{>Sidebar}}
            <main class="form-page fade-in">
                <a href="/Menu_Dishes" class="back-link">
                    <i class="fa-solid fa-arrow-left"></i>
                    Retour au menu
                </a>

                <div class="form-card">
                    <div class="form-card-header">
                        <div>
                            <p class="eyebrow">Menu</p>
                            <h1>Nouvel article</h1>
                        </div>
                        <div style="width:40px;height:40px;background:var(--primary-soft);border-radius:10px;display:grid;place-items:center;color:var(--primary);">
                            <i class="fa-solid fa-utensils"></i>
                        </div>
                    </div>

                    <div class="form-card-body">
                        <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
                            <div class="field-group">
                                <label for="dishTitle">Titre</label>
                                <input type="text" id="dishTitle" name="title" required value="{{this.title}}" placeholder="Nom du plat">
                            </div>
                            <div class="field-group">
                                <label for="dishPrice">Prix (DNT)</label>
                                <input type="number" id="dishPrice" name="price" value="{{this.price}}" required placeholder="0.00">
                            </div>
                        </div>

                        <div class="field-group">
                            <label for="dishDescription">Description</label>
                            <textarea id="dishDescription" name="description" rows="3" placeholder="Décrivez ce plat…">{{this.description}}</textarea>
                        </div>

                        <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
                            <div class="field-group">
                                <label for="dishSize">Variante / Taille</label>
                                <input type="text" id="dishSize" name="size" value="{{this.size}}" placeholder="Half, Full, Large…">
                            </div>
                            <div class="field-group">
                                <label for="dishCategory">Catégorie</label>
                                <select id="dishCategory" name="category">
                                    <option value="">Sélectionner une catégorie</option>
                                    {{#each categories}}
                                    <option value="{{this._id}}">{{this.title}}</option>
                                    {{/each}}
                                </select>
                            </div>
                        </div>

                        <div class="field-group">
                            <label for="dishImage">Image</label>
                            <input type="file" id="dishImage" name="image" accept="image/*">
                            <p class="field-hint">Formats acceptés : JPG, PNG, WEBP. Recommandé : 800×600px.</p>
                            <span id="imageAlert" class="field-error"></span>
                        </div>

                        <div class="form-actions">
                            <button type="button" class="btn-submit" onclick="addNewItem()">
                                <i class="fa-solid fa-plus" style="margin-right:6px;"></i>
                                Ajouter l'article
                            </button>
                            <button type="button" class="btn-cancel" onclick="cancelNewItemAdd()">
                                Annuler
                            </button>
                        </div>
                    </div>
                </div>

                <div id="successPopup" class="popup">
                    <div class="popup_content">
                        <i class="fa-solid fa-circle-check" style="color:#22C55E;"></i>
                        Article ajouté avec succès !
                    </div>
                </div>
            </main>
        </div>
    </div>

    <script src="/javascript/index.js"></script>
    <script>
        function addNewItem() {
            const title = document.getElementById('dishTitle').value;
            const description = document.getElementById('dishDescription').value;
            const price = document.getElementById('dishPrice').value;
            const size = document.getElementById('dishSize').value;
            const imageInput = document.getElementById('dishImage');
            const imageFile = imageInput.files[0];
            const categorySelect = document.getElementById('dishCategory');
            const selectedCategory = categorySelect.value;
            const imageAlert = document.getElementById('imageAlert');

            if (!selectedCategory) { imageAlert.textContent = 'Veuillez sélectionner une catégorie.'; return; }
            if (!imageFile) { imageAlert.textContent = 'Veuillez choisir une image.'; return; }
            imageAlert.textContent = '';

            const formData = new FormData();
            formData.append('title', title);
            formData.append('description', description);
            formData.append('price', price);
            formData.append('size', size);
            formData.append('image', imageFile);
            formData.append('category', selectedCategory);

            fetch('/Menu_Dishes_add', { method: 'POST', body: formData })
                .then(async Response => {
                    const data = await Response.text();
                    if (!Response.ok) throw new Error(data || "Erreur lors de l'ajout.");
                    return data;
                })
                .then(data => {
                    $('#successPopup').fadeIn();
                    document.getElementById('dishTitle').value = '';
                    document.getElementById('dishDescription').value = '';
                    document.getElementById('dishPrice').value = '';
                    document.getElementById('dishSize').value = '';
                    imageInput.value = '';
                    setTimeout(function() { $('#successPopup').fadeOut(); }, 5000);
                })
                .catch(err => {
                    imageAlert.textContent = err.message || "Erreur lors de l'ajout.";
                    console.error('Error:', err);
                });
        }

        function cancelNewItemAdd() {
            window.location.href = '/Menu_Dishes';
        }

        $(document).ready(function() {
            $(window).click(function(e) {
                if (!$(e.target).closest('.form-card').length) {
                    $('#successPopup').fadeOut();
                }
            });
        });
    </script>
</body>
</html>
