<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{#if isEditing}}Modifier l’article{{else}}Nouvel article{{/if}} | Le Patio</title>
    <link rel="stylesheet" href="/css/admin-theme.css">
    <link rel="stylesheet" href="/css/form-page.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
    <link rel="stylesheet" href="/css/patio-brand.css">
    <link rel="icon" href="/images/logo.png?v=website-icon">
</head>
<body>
    <div class="main">
        <div class="bigBox">
            {{>Sidebar}}
            <main class="form-page fade-in">
                <a href="/Menu_Dishes" class="back-link">
                    <i class="fa-solid fa-arrow-left"></i>
                    Retour au menu
                </a>

                <div class="form-card">
                    <div class="form-card-header">
                        <div>
                            <p class="eyebrow">Menu</p>
                            <h1>{{#if isEditing}}Modifier l’article{{else}}Nouvel article{{/if}}</h1>
                        </div>
                        <div style="width:40px;height:40px;background:var(--primary-soft);border-radius:10px;display:grid;place-items:center;color:var(--primary);">
                            <i class="fa-solid fa-utensils"></i>
                        </div>
                    </div>

                    <form class="form-card-body" id="catalogEditor" data-editor="product" data-id="{{_id}}" data-editing="{{isEditing}}">
                        <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
                            <div class="field-group">
                                <label for="dishTitle">Titre</label>
                                <input type="text" id="dishTitle" name="title" required value="{{this.title}}" placeholder="Nom du plat">
                            </div>
                            <div class="field-group">
                                <label for="dishPrice">Prix (DT)</label>
                                <input type="number" id="dishPrice" name="price" min="0" step="0.01" value="{{this.price}}" required placeholder="0.00">
                            </div>
                        </div>

                        <div class="field-group">
                            <label for="dishDescription">Description</label>
                            <textarea id="dishDescription" name="description" rows="3" required placeholder="Décrivez ce plat…">{{this.description}}</textarea>
                        </div>

                        <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
                            <div class="field-group">
                                <label for="dishSize">Variante / Taille</label>
                                <input type="text" id="dishSize" name="size" value="{{this.size}}" placeholder="Half, Full, Large…">
                            </div>
                            <div class="field-group">
                                <label for="dishCategory">Catégorie</label>
                                <select id="dishCategory" name="category" required>
                                    <option value="">Sélectionner une catégorie</option>
                                    {{#each categories}}
                                    <option value="{{this._id}}" {{#if selected}}selected{{/if}}>{{this.title}}</option>
                                    {{/each}}
                                </select>
                            </div>
                        </div>

                        <div class="field-group">
                            <label for="dishImage">Image</label>
                            {{#if isEditing}}<img class="editor-image-preview" src="{{imageUrl}}" alt="{{title}}"><p class="field-hint">Image actuelle. Laissez ce champ vide pour la conserver.</p>{{/if}}
                            <input type="file" id="dishImage" name="image" accept="image/*" {{#unless isEditing}}required{{/unless}}>
                            <p class="field-hint">Formats acceptés : JPG, PNG, WEBP. Recommandé : 800×600px.</p>
                            <span id="imageAlert" class="field-error"></span>
                        </div>

                        <div class="field-group">
                            <label for="dishAvailability">Disponibilité</label>
                            <label class="availability-control">
                                <input type="checkbox" role="switch" id="dishAvailability" name="isAvailable" value="true" aria-label="Disponibilité" {{#if isAvailable}}checked{{/if}}>
                                <span id="dishAvailabilityLabel">{{#if isAvailable}}Disponible{{else}}Épuisé{{/if}}</span>
                            </label>
                            <p class="field-hint">Un article épuisé reste visible dans le menu, mais ne peut plus être ajouté au panier.</p>
                        </div>

                        <div class="form-actions">
                            <button type="submit" class="btn-submit">
                                <i class="fa-solid {{#if isEditing}}fa-check{{else}}fa-plus{{/if}}" style="margin-right:6px;"></i>
                                {{#if isEditing}}Enregistrer les modifications{{else}}Ajouter l’article{{/if}}
                            </button>
                            <button type="button" class="btn-cancel" data-editor-cancel>
                                Annuler
                            </button>
                        </div>
                        <p id="editorMessage" role="status" aria-live="polite"></p>
                    </form>
                </div>

            </main>
        </div>
    </div>

    <script src="/javascript/index.js"></script>
    <script src="/javascript/catalog-editor.js"></script>
</body>
</html>
