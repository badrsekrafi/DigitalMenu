<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{#if isEditing}}Modifier la catégorie{{else}}Nouvelle catégorie{{/if}} | Le Patio</title>
    <link rel="stylesheet" href="/css/admin-theme.css">
    <link rel="stylesheet" href="/css/form-page.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
    <link rel="stylesheet" href="/css/patio-brand.css">
</head>
<body>
    <div class="main">
        <div class="bigBox">
            {{>Sidebar}}
            <main class="form-page fade-in">
                <a href="/Categories" class="back-link">
                    <i class="fa-solid fa-arrow-left"></i>
                    Retour aux catégories
                </a>

                <div class="form-card">
                    <div class="form-card-header">
                        <div>
                            <p class="eyebrow">Catalogue</p>
                            <h1>{{#if isEditing}}Modifier la catégorie{{else}}Nouvelle catégorie{{/if}}</h1>
                        </div>
                        <div style="width:40px;height:40px;background:var(--primary-soft);border-radius:10px;display:grid;place-items:center;color:var(--primary);">
                            <i class="fa-solid fa-tags"></i>
                        </div>
                    </div>

                    <form class="form-card-body" id="catalogEditor" data-editor="category" data-id="{{_id}}" data-editing="{{isEditing}}">
                        <div class="field-group">
                            <label for="catTitle">Titre</label>
                            <input type="text" id="catTitle" name="title" required value="{{this.title}}" placeholder="Ex: Boissons, Entrées…">
                        </div>

                        <div class="field-group">
                            <label for="catDescription">Description</label>
                            <textarea id="catDescription" name="description" rows="4" required placeholder="Décrivez cette catégorie…">{{this.description}}</textarea>
                        </div>

                        <div class="form-actions">
                            <button type="submit" class="btn-submit">
                                <i class="fa-solid {{#if isEditing}}fa-check{{else}}fa-plus{{/if}}" style="margin-right:6px;"></i>
                                {{#if isEditing}}Enregistrer les modifications{{else}}Ajouter la catégorie{{/if}}
                            </button>
                            <button type="button" class="btn-cancel" data-editor-cancel>
                                Annuler
                            </button>
                        </div>
                        <p id="editorMessage" role="status" aria-live="polite"></p>
                    </form>
                </div>

            </main>
        </div>
    </div>

    <script src="/javascript/index.js"></script>
    <script src="/javascript/catalog-editor.js"></script>
</body>
</html>
